23:
24:class MissingDatabaseUrlError(RuntimeError):
25:    """数据库连接串未配置: 明确报错, 不静默回退到默认库。"""
26:
27:
28:def build_engine(settings: ApplicationSettings) -> Engine:
29:    """按配置构建同步引擎; 每请求独立 Session 的基础。"""
30:    if settings.database_url is None:
31:        raise MissingDatabaseUrlError("DATABASE_URL is required for persistence")
32:    database_url = make_url(settings.database_url.get_secret_value())
33:    if database_url.get_backend_name() != "postgresql":
34:        raise MissingDatabaseUrlError("DATABASE_URL must use PostgreSQL")
35:    return create_engine(
36:        database_url.set(drivername="postgresql+psycopg"),
37:        pool_pre_ping=True,
38:        pool_size=5,
39:        max_overflow=5,
40:        pool_timeout=settings.dependency_timeout_seconds,
41:        connect_args={
42:            "connect_timeout": max(1, int(settings.dependency_timeout_seconds)),
43:            "options": f"-c statement_timeout={int(settings.dependency_timeout_seconds * 1000)} "
44:            f"-c lock_timeout={int(settings.dependency_timeout_seconds * 1000)}",
45:        },
46:    )
47:
48:
49:@contextmanager
50:def session_scope(engine: Engine) -> Iterator[Session]:
51:    """请求/任务级会话边界: 显式提交或回滚, 会话不跨线程共享。"""
52:    session_factory = sessionmaker(bind=engine, expire_on_commit=False)
53:    session = session_factory()
54:    try:
55:        yield session
56:        session.commit()
57:    except Exception:
58:        session.rollback()
59:        raise
60:    finally:
61:        session.close()
62:
63:
64:def run_migrations(database_url: str, target_revision: str = "head") -> None:
65:    """执行迁移到目标版本; 供空库升级与既有数据升级复用, 版本记录在 alembic_version。"""
66:    alembic_config = Config()
67:    alembic_config.set_main_option("script_location", str(MIGRATIONS_DIR))
68:    alembic_config.set_main_option("sqlalchemy.url", database_url.replace("%", "%%"))
69:    command.upgrade(alembic_config, target_revision)
70:
71:
72:def run_downgrade(database_url: str, target_revision: str) -> None:
73:    """回滚到指定版本; 回滚失败由 alembic 原样抛出, 不吞异常。"""
74:    alembic_config = Config()
75:    alembic_config.set_main_option("script_location", str(MIGRATIONS_DIR))
76:    alembic_config.set_main_option("sqlalchemy.url", database_url.replace("%", "%%"))
77:    command.downgrade(alembic_config, target_revision)
