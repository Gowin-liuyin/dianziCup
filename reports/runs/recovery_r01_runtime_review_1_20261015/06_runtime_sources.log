113:def build_health_router(
114:    settings: ApplicationSettings, engine: Engine | None, cache: Redis | None
115:) -> APIRouter:
116:    """配置不等于就绪；PG迁移、Redis及已配置搜索均实际探测。"""
117:    router = APIRouter(prefix="/health")
118:
119:    @router.get("/live")
120:    def health_live() -> dict[str, str]:
121:        return {"status": "live"}
122:
123:    @router.get("/ready")
124:    def health_ready() -> JSONResponse:
125:        dependencies: dict[str, dict[str, str]] = {}
126:        dependencies["database"] = {"state": "not_configured"}
127:        if engine is not None:
128:            try:
129:                with engine.connect() as connection:
130:                    connection.execute(text("SELECT 1"))
131:                    installed = connection.execute(
132:                        text("SELECT version_num FROM alembic_version")
133:                    ).scalar_one_or_none()
134:                expected = ScriptDirectory(str(MIGRATIONS_DIR)).get_current_head()
135:                dependencies["database"] = {
136:                    "state": "ready" if installed == expected else "migration_required"
137:                }
138:            except SQLAlchemyError:
139:                dependencies["database"] = {
140:                    "state": "unavailable",
141:                    "reason": "database connection or schema unavailable",
142:                }
143:        dependencies["cache"] = {"state": "not_configured"}
144:        if cache is not None:
145:            try:
146:                dependencies["cache"] = {"state": "ready" if cache.ping() else "unavailable"}
147:            except RedisError:
148:                dependencies["cache"] = {
149:                    "state": "unavailable",
150:                    "reason": "cache connection unavailable",
151:                }
152:        dependencies["search"] = {"state": "not_configured"}
153:        if settings.opensearch_url:
154:            try:
155:                with httpx.Client(
156:                    timeout=settings.dependency_timeout_seconds, trust_env=False
157:                ) as client:
158:                    response = client.get(settings.opensearch_url.rstrip("/") + "/_cluster/health")
159:                    response.raise_for_status()
160:                    search = response.json()
161:                dependencies["search"] = {
162:                    "state": "ready"
163:                    if (
164:                        isinstance(search, dict)
165:                        and isinstance(search.get("status"), str)
166:                        and search["status"] in {"yellow", "green"}
167:                    )
168:                    else "unavailable"
169:                }
170:            except (httpx.HTTPError, ValueError):
171:                dependencies["search"] = {
172:                    "state": "unavailable",
173:                    "reason": "search connection unavailable",
174:                }
175:        dependencies.update(
176:            {component: {"state": "not_observed_or_stale"} for component in ("worker", "scheduler")}
177:        )
178:        if engine is not None and dependencies["database"]["state"] == "ready":
179:            try:
180:                dependencies.update(read_runtime_readiness(engine, datetime.now(UTC)))
181:            except SQLAlchemyError:
182:                for component in ("worker", "scheduler"):
183:                    dependencies[component] = {"state": "unavailable"}
184:        core_ready = all(dependencies[name]["state"] == "ready" for name in ("database", "cache"))
185:        ready = core_ready and all(
186:            dependency["state"] == "ready" for dependency in dependencies.values()
187:        )
188:        if ready:
189:            status = "ready"
190:        elif core_ready:
191:            status = "degraded"
192:        else:
193:            status = "not_ready"
194:        return JSONResponse(
195:            status_code=200 if ready else 503,
196:            content={
197:                "status": status,
198:                "reason": "all core dependencies available"
199:                if ready
200:                else "required dependencies unavailable or search degraded",
201:                "dependencies": dependencies,
202:                "data_mode": settings.data_mode,
203:            },
204:        )
205:
206:    return router
