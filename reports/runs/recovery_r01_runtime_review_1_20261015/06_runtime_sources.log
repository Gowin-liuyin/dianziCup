53:def observe_runtime_component(component: str) -> dict[str, str]:
54:    """运行进程完成实际PG查询再提交观测；失败只返回固定错误类别。"""
55:    engine = build_engine(load_application_settings())
56:    try:
57:        with engine.connect() as connection:
58:            connection.execute(text("SELECT 1")).scalar_one()
59:        record_runtime_observation(engine, component, datetime.now(UTC))
60:        return {"component": component, "state": "observed"}
61:    except SQLAlchemyError:
62:        raise RuntimeError("runtime database unavailable") from None
63:    finally:
64:        engine.dispose()
