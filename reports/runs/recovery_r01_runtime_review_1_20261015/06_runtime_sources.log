1:"""PG存储运行观测；仅证明组件最近执行，不替代事实或任务状态。"""
2:
3:from datetime import UTC, datetime, timedelta
4:
5:from sqlalchemy import select
6:from sqlalchemy.dialects.postgresql import insert
7:from sqlalchemy.engine import Engine
8:
9:from ai_intel.knowledge.models import runtime_observations
10:
11:RUNTIME_MAX_AGE_SECONDS = 45
12:
13:
14:def record_runtime_observation(engine: Engine, component: str, observed_at: datetime) -> None:
15:    """实际执行成功后更新观测；PG失败抛出，不能先写假就绪。"""
16:    if component not in {"worker", "scheduler"}:
17:        raise ValueError("unsupported runtime component")
18:    statement = insert(runtime_observations).values(
19:        component=component, observed_at=observed_at, platform_version="0.1.0"
20:    )
21:    with engine.begin() as connection:
22:        connection.execute(
23:            statement.on_conflict_do_update(
24:                index_elements=[runtime_observations.c.component],
25:                set_={"observed_at": observed_at, "platform_version": "0.1.0"},
26:            )
27:        )
28:
29:
30:def read_runtime_readiness(engine: Engine, now: datetime) -> dict[str, dict[str, str]]:
31:    """未观测、过期或时钟在未来均不就绪；只返回固定组件与状态。"""
32:    with engine.connect() as connection:
33:        rows = connection.execute(
34:            select(runtime_observations.c.component, runtime_observations.c.observed_at)
35:        ).all()
36:        observed: dict[str, datetime] = {str(row[0]): row[1] for row in rows}
37:    earliest = now - timedelta(seconds=RUNTIME_MAX_AGE_SECONDS)
38:    return {
39:        component: {
40:            "state": "ready"
41:            if component in observed and earliest <= observed[component].astimezone(UTC) <= now
42:            else "not_observed_or_stale"
43:        }
44:        for component in ("worker", "scheduler")
45:    }
