1:"""本工作包验证记录；只加载本包仓库外随机测试秘密，不输出连接内容。"""
2:
3:from __future__ import annotations
4:
5:import hashlib
6:import json
7:import os
8:import subprocess
9:import sys
10:import time
11:from datetime import datetime, timedelta, timezone
12:from pathlib import Path
13:from xml.etree import ElementTree
14:
15:ROOT = Path(__file__).resolve().parents[3]
16:OUTPUT = Path(__file__).resolve().parent
17:OUTPUT = OUTPUT / os.environ.get("R01_INFRA_EVIDENCE_SUBDIRECTORY", "")
18:OUTPUT.mkdir(parents=True, exist_ok=True)
19:BACKEND = ROOT / "backend"
20:WSL = ["wsl.exe", "-d", "Ubuntu-22.04", "-u", "root", "--exec"]
21:DOCKER = [*WSL, "/tmp/dianzi-docker-static-r01-20261014/portable/docker/docker",
22:          "--config", "/tmp/dianzi-docker-static-r01-20261014/runtime/client-config",
23:          "--host", "unix:///tmp/dianzi-docker-static-r01-20261014/runtime/docker.sock"]
24:PRIVATE_FILE = "/tmp/dianzi-r01-infra-20261015/connection.json"
25:HEAD = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
26:environment = dict(os.environ)
27:environment["PYTHONIOENCODING"] = "utf-8"
28:environment["DIANZI_DOCKER_COMMAND_JSON"] = json.dumps(DOCKER)
29:
30:
31:def timestamp() -> str:
32:    return datetime.now(timezone(timedelta(hours=8))).isoformat(timespec="seconds")
33:
34:
35:def redact(value: str) -> str:
36:    for name, secret in environment.items():
37:        if secret and ("PASSWORD" in name or "PROXY" in name or name in {"DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "TEST_REDIS_URL"}):
38:            value = value.replace(secret, "[redacted test credential]")
39:    return value
40:
41:
42:def execute(name: str, command: list[str], cwd: Path = ROOT, timeout: int = 240) -> int:
43:    started = timestamp()
44:    start_clock = time.monotonic()
45:    try:
46:        completed = subprocess.run(command, cwd=cwd, env=environment, capture_output=True,
47:                                   text=True, encoding="utf-8", errors="replace", timeout=timeout)
48:        stdout, stderr, code = completed.stdout, completed.stderr, completed.returncode
49:    except subprocess.TimeoutExpired as expired:
50:        stdout = expired.stdout.decode(errors="replace") if isinstance(expired.stdout, bytes) else expired.stdout or ""
51:        stderr = expired.stderr.decode(errors="replace") if isinstance(expired.stderr, bytes) else expired.stderr or ""
52:        code = 124
53:    (OUTPUT / f"{name}.stdout.log").write_text(redact(stdout), encoding="utf-8")
54:    (OUTPUT / f"{name}.stderr.log").write_text(redact(stderr), encoding="utf-8")
55:    counts = None
56:    xml = OUTPUT / f"{name}.xml"
57:    if xml.is_file():
58:        xml.write_text(redact(xml.read_text(encoding="utf-8")), encoding="utf-8")
59:        cases = ElementTree.parse(xml).findall(".//testcase")
60:        counts = {"tests": len(cases), "failed": sum(c.find("failure") is not None for c in cases),
61:                  "errors": sum(c.find("error") is not None for c in cases), "skipped": sum(c.find("skipped") is not None for c in cases)}
62:    receipt = {"command": command, "cwd": str(cwd), "start": started, "end": timestamp(),
63:               "wall_clock_seconds": time.monotonic() - start_clock, "exit_code": code,
64:               "code_sha": HEAD, "counts": counts}
65:    (OUTPUT / f"{name}.json").write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
66:    print(json.dumps({"name": name, "exit": code, "counts": counts}), flush=True)
67:    return code
