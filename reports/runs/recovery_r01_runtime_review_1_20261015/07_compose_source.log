1:ARG UV_IMAGE=ghcr.io/astral-sh/uv@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82
2:ARG PYTHON_IMAGE=python@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
3:FROM ${UV_IMAGE} AS uv
4:FROM ${PYTHON_IMAGE}
5:COPY --from=uv /uv /usr/local/bin/uv
6:WORKDIR /app
7:ENV UV_PROJECT_ENVIRONMENT=/opt/venv
8:ENV PATH="/opt/venv/bin:$PATH"
9:COPY backend/pyproject.toml backend/uv.lock ./
10:RUN uv sync --locked --no-dev --no-install-project
11:COPY backend/src ./src
12:COPY backend/migrations ./migrations
13:RUN uv sync --locked --no-dev && groupadd --gid 10001 ai-intel && useradd --uid 10001 --gid 10001 --create-home --no-log-init ai-intel && mkdir -p /var/lib/ai-intel/raw && chown -R 10001:10001 /app /var/lib/ai-intel
14:USER 10001:10001
15:CMD ["uvicorn", "ai_intel.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
