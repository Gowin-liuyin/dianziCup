150:def test_concurrent_login_reserves_attempt_before_directory_io() -> None:
151:    class SlowDirectory(InMemoryUserDirectory):
152:        def find_by_username(self, username: str) -> UserAccount | None:
153:            sleep(0.05)
154:            return None
155:
156:    service = AuthenticationSessionService(SlowDirectory(), (ORIGIN,), False)
157:    barrier = Barrier(8)
158:
159:    def login_attempt(_: int) -> int:
160:        barrier.wait(timeout=5)
161:        try:
162:            service.login("missing-fixture", "synthetic-password", ORIGIN, "same-client")
163:        except LoginRateLimitedError:
164:            return 429
165:        except InvalidCredentialsError:
166:            return 401
167:        raise AssertionError("missing user unexpectedly logged in")
168:
169:    with ThreadPoolExecutor(max_workers=8) as pool:
170:        results = list(pool.map(login_attempt, range(8)))
171:    assert results.count(401) == 5
172:    assert results.count(429) == 3
