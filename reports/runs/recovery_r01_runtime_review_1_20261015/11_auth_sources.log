192:class AuthenticationSessionService:
193:    """登录/注销/会话校验 + 登录限流 + 审计事件(脱敏)。"""
194:
195:    def __init__(
196:        self,
197:        user_directory: UserDirectory,
198:        allowed_origins: tuple[str, ...],
199:        cookie_secure: bool,
200:        clock: Callable[[], datetime] | None = None,
201:    ) -> None:
202:        self._user_directory = user_directory
203:        self._allowed_origins = allowed_origins
204:        self._cookie_secure = cookie_secure
205:        self._clock = clock or (lambda: datetime.now(UTC))
206:        self._password_hasher = PasswordHasher()
207:        self._sessions: dict[str, SessionRecord] = {}
208:        self._login_attempts: dict[str, list[float]] = {}
209:        self._login_lock = Lock()
210:        self._audit_events: list[dict[str, str]] = []
211:
212:    def create_precreated_user(
213:        self, username: str, password: str, tenant_id: str | None, role: Role
214:    ) -> UserAccount:
215:        """管理路径创建用户: 仅存 Argon2id 哈希, 重复用户名拒绝。"""
216:        account = UserAccount(
217:            user_id=str(uuid.uuid4()),
218:            username=username,
219:            password_hash=self._password_hasher.hash(password),
220:            tenant_id=tenant_id,
221:            role=role,
222:        )
223:        self._user_directory.add_precreated_user(account)
224:        return account
225:
226:    def login(
227:        self, username: str, password: str, origin: str | None, client_key: str
228:    ) -> tuple[str, SessionRecord]:
229:        """登录: 凭证与 Origin 校验后签发不透明会话; 失败统一报错。"""
230:        if origin is not None and origin not in self._allowed_origins:
231:            raise CsrfRejectionError("origin not allowed")
232:        self._reserve_login_attempt(client_key)
233:        account = self._user_directory.find_by_username(username)
234:        if account is None:
235:            self._append_audit(
236:                "login_failed", {"reason": "invalid_credentials", "trace_id": str(uuid.uuid4())}
237:            )
238:            raise InvalidCredentialsError("invalid credentials")
239:        try:
240:            self._password_hasher.verify(account.password_hash, password)
241:        except VerifyMismatchError:
242:            self._append_audit(
243:                "login_failed", {"reason": "invalid_credentials", "trace_id": str(uuid.uuid4())}
244:            )
245:            raise InvalidCredentialsError("invalid credentials") from None
246:        session_token = secrets.token_urlsafe(32)
247:        session_record = SessionRecord(
248:            session_id=self._session_key(session_token),
249:            user_id=account.user_id,
250:            expires_at=self._clock() + timedelta(seconds=SESSION_TTL_SECONDS),
251:            csrf_token=secrets.token_urlsafe(32),
252:        )
253:        self._sessions[self._session_key(session_token)] = session_record
254:        self._append_audit(
255:            "login_succeeded", {"user_id": account.user_id, "trace_id": str(uuid.uuid4())}
256:        )
257:        return session_token, session_record
258:
259:    def logout(self, session_token: str) -> None:
260:        """注销: 立即失效, 重复注销幂等。"""
261:        session_record = self._sessions.get(self._session_key(session_token))
262:        if session_record is not None:
263:            session_record.revoked = True
264:            self._append_audit(
265:                "logout", {"user_id": session_record.user_id, "trace_id": str(uuid.uuid4())}
266:            )
267:
268:    def validate_session(self, session_token: str) -> Principal:
269:        """校验会话得到主体; 过期/注销/未知统一 SessionExpiredError。"""
270:        principal, _ = self.authenticated_session(session_token)
271:        return principal
272:
273:    def authenticated_session(self, session_token: str) -> tuple[Principal, SessionRecord]:
274:        """一次会话及账户读取，绑定身份与CSRF；不组合两次HTTP会话快照。"""
275:        session_record = self._sessions.get(self._session_key(session_token))
276:        if (
277:            session_record is None
278:            or session_record.revoked
279:            or session_record.expires_at <= self._clock()
280:        ):
281:            raise SessionExpiredError("session is not valid")
282:        account = self._user_directory.find_by_id(session_record.user_id)
283:        if account is None:
284:            raise SessionExpiredError("session is not valid")
285:        return (
286:            Principal(user_id=account.user_id, tenant_id=account.tenant_id, role=account.role),
287:            session_record,
288:        )
289:
290:    def session_record(self, session_token: str) -> SessionRecord:
291:        """返回有效会话记录(含 CSRF 令牌), 供 /auth/csrf 下发; 无效/过期/撤销抛对应错误。"""
292:        _, record = self.authenticated_session(session_token)
293:        return record
294:
295:    def build_access_scope(self, session_token: str) -> AccessScope:
296:        """服务端由会话构造 AccessScope; 请求体自报身份在此无入口。"""
297:        principal = self.validate_session(session_token)
298:        return AccessScope.for_authenticated_user(
299:            principal.user_id, principal.tenant_id, principal.role
300:        )
301:
302:    def validate_write_request(
303:        self, session_token: str, csrf_token: str, origin: str | None
304:    ) -> None:
305:        """写请求必须会话有效、CSRF 令牌匹配且 Origin 合法。"""
306:        session_record = self._sessions.get(self._session_key(session_token))
307:        if (
308:            session_record is None
309:            or session_record.revoked
310:            or session_record.expires_at <= self._clock()
311:        ):
312:            raise SessionExpiredError("session is not valid")
313:        if not csrf_token.isascii() or not hmac.compare_digest(
314:            session_record.csrf_token, csrf_token
315:        ):
316:            raise CsrfRejectionError("csrf token mismatch")
317:        if origin is None or origin not in self._allowed_origins:
318:            raise CsrfRejectionError("origin not allowed")
319:
320:    def cookie_attributes(self) -> dict[str, str | bool]:
321:        """Cookie 策略: HttpOnly + SameSite=Strict; production 强制 Secure。"""
322:        return {"httponly": True, "samesite": "strict", "secure": self._cookie_secure}
323:
324:    def audit_events(self) -> list[dict[str, str]]:
325:        """审计事件副本: 供测试与审计接口消费。"""
326:        return [dict(event) for event in self._audit_events]
327:
328:    def record_identity_spoof_attempt(self, submitted_fields: dict[str, str]) -> None:
329:        """请求体携带自报身份字段时记录安全审计事件(仅记字段名与 trace_id, 不记值)。"""
330:        self._append_audit(
331:            "identity_spoof_attempt",
332:            {"submitted_keys": ",".join(sorted(submitted_fields)), "trace_id": str(uuid.uuid4())},
333:        )
334:
335:    @staticmethod
336:    def _session_key(session_token: str) -> str:
337:        """会话以服务端哈希为键存储, 落库/内存不保存明文 token(05 §1 合同)。"""
338:        return hashlib.sha256(session_token.encode("utf-8")).hexdigest()
339:
340:    def _reserve_login_attempt(self, client_key: str) -> None:
341:        """昂贵目录/密码IO前原子占位；成功登录不能清除其他在途尝试。"""
342:        with self._login_lock:
343:            now_epoch = time.time()
344:            attempts = [
345:                stamp
346:                for stamp in self._login_attempts.get(client_key, [])
347:                if now_epoch - stamp < LOGIN_WINDOW_SECONDS
348:            ]
349:            if len(attempts) >= MAX_LOGIN_ATTEMPTS:
350:                raise LoginRateLimitedError("too many login attempts")
351:            attempts.append(now_epoch)
352:            self._login_attempts[client_key] = attempts
353:
354:    def _append_audit(self, event_type: str, fields: dict[str, str]) -> None:
355:        """写入审计事件: 拒绝敏感字段名, 事件带 trace_id。"""
356:        if "trace_id" not in fields:
357:            raise AuditEventError("audit event requires trace_id")
358:        for key in fields:
359:            lowered = key.lower()
360:            if any(marker in lowered for marker in SENSITIVE_AUDIT_MARKERS):
361:                raise AuditEventError(f"sensitive field refused in audit event: {key}")
362:        self._audit_events.append({"event_type": event_type, **fields})
