120:class DatabaseUserDirectory:
121:    """数据库用户目录: 预创建用户持久化到 PostgreSQL, 重启后仍可用。"""
122:
123:    def __init__(self, engine: Engine) -> None:
124:        self._engine = engine
125:
126:    def add_precreated_user(self, account: UserAccount) -> None:
127:        """持久化预创建用户; 用户名重复由唯一键拒绝。"""
128:        from sqlalchemy import insert
129:        from sqlalchemy.exc import IntegrityError
130:
131:        from ai_intel.knowledge.models import users
132:
133:        try:
134:            with self._engine.begin() as connection:
135:                connection.execute(
136:                    insert(users).values(
137:                        user_id=account.user_id,
138:                        username=account.username,
139:                        password_hash=account.password_hash,
140:                        tenant_id=account.tenant_id,
141:                        role=account.role.value,
142:                        created_at=datetime.now(UTC),
143:                    )
144:                )
145:        except IntegrityError as duplicate:
146:            raise ValueError("username already exists") from duplicate
147:
148:    def find_by_username(self, username: str) -> UserAccount | None:
149:        """按用户名查找持久化账户。"""
150:        from sqlalchemy import select
151:
152:        from ai_intel.knowledge.models import users
153:
154:        with self._engine.connect() as connection:
155:            row = (
156:                connection.execute(select(users).where(users.c.username == username))
157:                .mappings()
158:                .first()
159:            )
160:        return self._row_to_account(row)
161:
162:    def find_by_id(self, user_id: str) -> UserAccount | None:
163:        """按用户 id 查找持久化账户。"""
164:        from sqlalchemy import select
165:
166:        from ai_intel.knowledge.models import users
167:
168:        with self._engine.connect() as connection:
169:            row = (
170:                connection.execute(select(users).where(users.c.user_id == user_id))
171:                .mappings()
172:                .first()
173:            )
174:        return self._row_to_account(row)
175:
176:    @staticmethod
177:    def _row_to_account(row: RowMapping | None) -> UserAccount | None:
178:        """把数据库行映射回账户对象; 无行返回 None。"""
179:        if row is None:
180:            return None
181:        fields = row
182:        tenant_value = fields["tenant_id"]
183:        return UserAccount(
184:            user_id=str(fields["user_id"]),
185:            username=str(fields["username"]),
186:            password_hash=str(fields["password_hash"]),
187:            tenant_id=str(tenant_value) if tenant_value is not None else None,
188:            role=Role(str(fields["role"])),
189:        )
