"""测试资源仅在 fixture 执行时连接；导入及 collect-only 不访问外部资源。"""

from __future__ import annotations

import os
import sys
from collections.abc import Generator, Iterator
from pathlib import Path
from urllib.parse import unquote, urlsplit

import pytest
from sqlalchemy import create_engine, text
from sqlalchemy.engine import Engine
from sqlalchemy.exc import OperationalError

from ai_intel.infrastructure.database import run_migrations

PROJECT_ROOT = Path(__file__).resolve().parents[2]


def redact_test_connection_output(output: str) -> str:
    """测试断言失败也不得把 fixture 参数的真实连接串/密码写入终端或 JUnit。"""
    for name in ("TEST_DATABASE_URL", "TEST_REDIS_URL"):
        value = os.environ.get(name, "")
        if not value:
            continue
        output = output.replace(value, "[redacted test connection]")
        try:
            password = unquote(urlsplit(value).password or "")
        except ValueError:
            continue
        if password:
            output = output.replace(password, "[redacted test credential]")
    return output


@pytest.hookimpl(wrapper=True)
def pytest_runtest_makereport(
    item: pytest.Item, call: pytest.CallInfo[None]
) -> Generator[None, pytest.TestReport, pytest.TestReport]:
    """仅脱敏报告内容，保留测试 outcome、错误/失败/skip 数量。"""
    report = yield
    if report.longrepr is not None:
        original = report.longreprtext
        redacted = redact_test_connection_output(original)
        if redacted != original:
            report.longrepr = redacted
    report.sections = [
        (name, redact_test_connection_output(value)) for name, value in report.sections
    ]
    return report


def pytest_configure(config: pytest.Config) -> None:
    """注册真实资源标记并使测试共享唯一脚本隔离规则，生产不依赖脚本。"""
    sys.path.insert(0, str(PROJECT_ROOT))
    config.addinivalue_line(
        "markers", "real_pg: requires an explicitly isolated PostgreSQL test database"
    )
    config.addinivalue_line(
        "markers", "real_services: requires an explicitly isolated Compose test project"
    )


@pytest.fixture()
def isolated_test_database_url() -> str:
    """缺少隔离资源记错误/blocked，不通过 skip 隐藏缺测。"""
    from scripts.dev import TestEnvironmentError, require_isolated_test_database

    try:
        return require_isolated_test_database()
    except TestEnvironmentError as blocked:
        raise pytest.UsageError(f"blocked: {blocked}") from None


@pytest.fixture()
def migrated_engine(isolated_test_database_url: str) -> Iterator[Engine]:
    """验证实际库/用户身份后迁移；只访问经隔离规则核准的 PostgreSQL。"""
    engine = create_engine(
        isolated_test_database_url,
        connect_args={
            "connect_timeout": 5,
            "options": "-c statement_timeout=20000 -c lock_timeout=5000",
        },
    )
    try:
        with engine.connect() as connection:
            database_name, username = connection.execute(
                text("SELECT current_database(), current_user")
            ).one()
            assert database_name == engine.url.database
            assert username == engine.url.username
        migration_url = engine.url.update_query_dict(
            {"connect_timeout": "5", "options": "-c statement_timeout=20000 -c lock_timeout=5000"}
        ).render_as_string(hide_password=False)
        run_migrations(migration_url)
    except OperationalError:
        engine.dispose()
        raise pytest.UsageError(
            "blocked: isolated PostgreSQL connection/migration unavailable"
        ) from None
    try:
        yield engine
    finally:
        engine.dispose()
name: ci

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  backend:
    name: backend checks and isolated services
    runs-on: ubuntu-latest
    timeout-minutes: 25
    env:
      COMPOSE_DISABLE_ENV_FILE: "1"
      DIANZI_TEST_COMPOSE_FILE: infra/compose/compose.test.yaml
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: astral-sh/setup-uv@v5
      - name: Install locked backend
        run: uv sync --locked --project backend
      - name: Static checks
        working-directory: backend
        run: |
          uv run --locked ruff check . ../scripts/dev.py
          uv run --locked ruff format --check . ../scripts/dev.py
          uv run --locked mypy src ../scripts/dev.py
      - name: Create disposable test configuration
        run: |
          python - <<'PY'
          import json, os, secrets
          from pathlib import Path
          run_id = f"r01_ci_{os.environ['GITHUB_RUN_ID']}_{os.environ['GITHUB_RUN_ATTEMPT']}"
          password = secrets.token_urlsafe(32)
          redis_password = secrets.token_urlsafe(32)
          search_password = secrets.token_urlsafe(32) + "aA1!"
          database = f"test_dianzi_{run_id}"
          database_url = f"postgresql+psycopg://{database}:{password}@127.0.0.1:25436/{database}"
          redis_url = f"redis://:{redis_password}@127.0.0.1:26383/0"
          values = {
              "DIANZI_TEST_RUN_ID": run_id,
              "DIANZI_TEST_COMPOSE_PROJECT": f"dianzi-test-{run_id}",
              "TEST_DATABASE_URL": database_url,
              "TEST_REDIS_URL": redis_url,
              "TEST_OPENSEARCH_URL": "http://127.0.0.1:29201",
              "POSTGRES_DB": database, "POSTGRES_USER": database,
              "POSTGRES_PASSWORD": password, "POSTGRES_PORT": "25436",
              "REDIS_PASSWORD": redis_password, "REDIS_PORT": "26383",
              "OPENSEARCH_INITIAL_ADMIN_PASSWORD": search_password,
              "OPENSEARCH_PORT": "29201",
              "TEST_POSTGRES_USER": database, "TEST_POSTGRES_PASSWORD": password,
              "TEST_POSTGRES_PORT": "25436", "TEST_REDIS_PASSWORD": redis_password,
              "TEST_REDIS_PORT": "26383", "TEST_OPENSEARCH_PORT": "29201",
              "COMPOSE_DATABASE_URL": database_url, "COMPOSE_REDIS_URL": redis_url,
              "COMPOSE_ALLOWED_ORIGINS": json.dumps(["http://127.0.0.1:25201"]),
              "API_PORT": "28201", "FRONTEND_PORT": "25201",
              "VITE_API_BASE_URL": "http://127.0.0.1:28201",
          }
          for value in (password, redis_password, search_password, database_url, redis_url):
              print(f"::add-mask::{value}")
          with Path(os.environ["GITHUB_ENV"]).open("a", encoding="utf-8") as output:
              for name, value in values.items():
                  output.write(f"{name}={value}\n")
          PY
      - name: Start isolated PostgreSQL Redis and search
        run: >-
          docker compose --project-name "$DIANZI_TEST_COMPOSE_PROJECT"
          -f "$DIANZI_TEST_COMPOSE_FILE" --profile core --profile search
          up -d --wait --wait-timeout 180
      - name: Unit tests with actual test counts
        run: python scripts/dev.py check --scope unit --timeout-seconds 600
      - name: Contract tests including real PostgreSQL
        if: ${{ !cancelled() }}
        run: python scripts/dev.py check --scope contract --timeout-seconds 600
      - name: Security tests
        if: ${{ !cancelled() }}
        run: python scripts/dev.py check --scope security --timeout-seconds 600
      - name: Integration tests including Compose lifecycle
        if: ${{ !cancelled() }}
        run: python scripts/dev.py check --scope integration --timeout-seconds 600
      - name: Stop only this test project and preserve volumes
        if: always()
        run: |
          test -n "$DIANZI_TEST_COMPOSE_PROJECT"
          test "$DIANZI_TEST_COMPOSE_PROJECT" = "dianzi-test-$DIANZI_TEST_RUN_ID"
          docker compose --project-name "$DIANZI_TEST_COMPOSE_PROJECT" -f "$DIANZI_TEST_COMPOSE_FILE" --profile core --profile search down

  frontend:
    name: frontend checks
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
      - run: npm ci
        working-directory: frontend
      - name: Lint typecheck tests and build with test counts
        run: python scripts/dev.py check --scope frontend --timeout-seconds 600
