Usage:
  codebase-memory-mcp cli get_architecture --flag value [--flag2 value2 ...]
  codebase-memory-mcp cli get_architecture --args-file <path-to-json>
  echo '<json>' | codebase-memory-mcp cli get_architecture
  codebase-memory-mcp cli get_architecture '<raw-json-args>'

Flags:
  --project <string> [required]
  --path <string>  Directory prefix (for example apps/hoa).
  --aspects <array>  all=everything; overview=compact except file_tree; omitted=languages/packages/entry_points; cycles is opt-in.
  --format <tree|json> [default: tree]
Usage:
  codebase-memory-mcp cli trace_path --flag value [--flag2 value2 ...]
  codebase-memory-mcp cli trace_path --args-file <path-to-json>
  echo '<json>' | codebase-memory-mcp cli trace_path
  codebase-memory-mcp cli trace_path '<raw-json-args>'

Flags:
  --function-name <string> [required]
  --project <string> [required]
  --direction <inbound|outbound|both> [default: both]
  --depth <integer> [default: 3]
  --limit <integer> [default: 100]  Rows/page; gte flags the 5000-node engine ceiling.
  --max-output-tokens <integer> [default: 3200]  Sizing hint; hard ceiling is 4 UTF-8 bytes/token. Evidence/args yield before nearest graph rows.
  --cursor <string>  Pass next/next_cursor with traversal args unchanged; budget may increase.
  --mode <calls|data_flow|cross_service> [default: calls]  calls, argument-aware data_flow, or service edges.
  --parameter-name <string>  data_flow parameter filter.
  --edge-types <array>
  --risk-labels <boolean> [default: false]  Add hop-risk labels.
  --include-tests <boolean> [default: false]
  --format <tree|json> [default: tree]  tree chooses smaller complete direct/grouped output; json uses stable grouped tables.
  --include-evidence <boolean> [default: false]  Add resolver class and confidence.
