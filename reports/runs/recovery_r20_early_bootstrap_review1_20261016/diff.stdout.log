+def _read_windows_cpu_ticks(kernel: ctypes.WinDLL, process_handle: int) -> int:
+    times = [ctypes.c_ulonglong() for _ in range(4)]
+    if not kernel.GetProcessTimes(process_handle, *(ctypes.byref(value) for value in times)):
+        raise ctypes.WinError(ctypes.get_last_error())
+    return times[2].value + times[3].value
+
+
+class _WindowsWorkerSupervisor:
+    """Own a true worker handle independently of the disposable guardian.
+
+    The existing 50ms poll remains a sampled safeguard, without a hard realtime bound.
+    Closing this owner is allowed only after the caller has ended its worker.
+    """
+
+    def __init__(
+        self, process_handle: int, guard: subprocess.Popen[bytes], cpu_seconds: int
+    ) -> None:
+        self.guard = guard
+        self.error: OSError | None = None
+        self.last_cpu_ticks = 0
+        self._cpu_ticks = cpu_seconds * 10_000_000
+        self._stop = threading.Event()
+        self._kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+        self._kernel.GetCurrentProcess.restype = wintypes.HANDLE
+        self._kernel.DuplicateHandle.argtypes = [
+            wintypes.HANDLE,
+            wintypes.HANDLE,
+            wintypes.HANDLE,
+            ctypes.c_void_p,
+            wintypes.DWORD,
+            wintypes.BOOL,
+            wintypes.DWORD,
+        ]
+        self._kernel.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+        self._kernel.GetProcessTimes.argtypes = [wintypes.HANDLE] + [ctypes.c_void_p] * 4
+        self._kernel.TerminateProcess.argtypes = [wintypes.HANDLE, wintypes.UINT]
+        self._kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+        retained = wintypes.HANDLE()
+        current = self._kernel.GetCurrentProcess()
+        if not self._kernel.DuplicateHandle(
+            current, process_handle, current, ctypes.byref(retained), 0, False, 2
+        ):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if retained.value is None:
+            raise OSError("worker CPU supervision handle unavailable")
+        self._handle = retained.value
+        self._thread = threading.Thread(target=self._supervise, daemon=True)
+        try:
+            self._thread.start()
+        except RuntimeError:
+            self._kernel.CloseHandle(self._handle)
+            raise
+
+    def _supervise(self) -> None:
+        try:
+            while True:
+                state = self._kernel.WaitForSingleObject(self._handle, 50)
+                if state == 0:
+                    self.last_cpu_ticks = _read_windows_cpu_ticks(self._kernel, self._handle)
+                    if self.last_cpu_ticks >= self._cpu_ticks:
+                        raise OSError("worker CPU budget exhausted")
+                    return
+                if state != 258:
+                    raise ctypes.WinError(ctypes.get_last_error())
+                self.last_cpu_ticks = _read_windows_cpu_ticks(self._kernel, self._handle)
+                if self.last_cpu_ticks >= self._cpu_ticks:
+                    raise OSError("worker CPU budget exhausted")
+                if self.guard.poll() is not None:
+                    raise OSError("worker CPU guardian exited")
+                if self._stop.is_set():
+                    raise OSError("worker CPU supervision closed before worker exit")
+        except OSError as error:
+            self.error = error
+            if (
+                not self._kernel.TerminateProcess(self._handle, 0xC0000044)
+                and self._kernel.WaitForSingleObject(self._handle, 0) != 0
+            ):
+                self.error.add_note(str(ctypes.WinError(ctypes.get_last_error())))
+        finally:
+            self._kernel.CloseHandle(self._handle)
+
+    def close(self) -> None:
+        self._stop.set()
+        self._thread.join(timeout=1)
+        if self._thread.is_alive():
+            raise OSError("worker CPU supervision did not end")
+        try:
+            self.guard.wait(timeout=1)
+        except subprocess.TimeoutExpired:
+            self.guard.kill()
+            self.guard.wait(timeout=1)
+        if self.guard.returncode != 0 and self.error is None:
+            self.error = OSError("worker CPU guardian exited")
+
+
+def _launch_windows_worker(
+    entrypoint: Literal["pdf", "semantic"],
+    *,
+    memory_bytes: int,
+    cpu_seconds: int,
+    environment: dict[str, str],
+    spawn_arguments: tuple[int, int] | None = None,
+) -> tuple[subprocess.Popen[bytes], _WindowsWorkerSupervisor]:
+    """Gate only the two fixed workers before site, coverage and application imports."""
+    if sys.platform != "win32" or entrypoint not in ("pdf", "semantic"):
+        raise OSError("early worker bootstrap unavailable")
+    if (entrypoint == "semantic") != (spawn_arguments is not None):
+        raise ValueError("fixed worker bootstrap arguments differ from its entrypoint")
+    if type(memory_bytes) is not int or not 1 <= memory_bytes <= 2 * 1024**3:
+        raise ValueError("invalid fixed worker memory envelope")
+    if type(cpu_seconds) is not int or not 1 <= cpu_seconds <= 30:
+        raise ValueError("invalid fixed worker CPU envelope")
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.CreateJobObjectW.argtypes = [ctypes.c_void_p, wintypes.LPCWSTR]
+    kernel.CreateJobObjectW.restype = wintypes.HANDLE
+    kernel.CreateEventW.argtypes = [ctypes.c_void_p, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR]
+    kernel.CreateEventW.restype = wintypes.HANDLE
+    kernel.SetInformationJobObject.argtypes = [
+        wintypes.HANDLE,
+        ctypes.c_int,
+        ctypes.c_void_p,
+        wintypes.DWORD,
+    ]
+    kernel.AssignProcessToJobObject.argtypes = [wintypes.HANDLE, wintypes.HANDLE]
+    kernel.SetEvent.argtypes = [wintypes.HANDLE]
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    handles: list[int] = []
+    process: subprocess.Popen[bytes] | None = None
+    guard: subprocess.Popen[bytes] | None = None
+    supervisor: _WindowsWorkerSupervisor | None = None
+    try:
+        gate = kernel.CreateEventW(None, True, False, None)
+        if gate is None:
+            raise ctypes.WinError(ctypes.get_last_error())
+        handles.append(gate)
+        job = kernel.CreateJobObjectW(None, None)
+        if job is None:
+            raise ctypes.WinError(ctypes.get_last_error())
+        handles.append(job)
+        limits = ExtendedLimits()
+        limits.basic.flags = 0x100 | 0x2 | 0x2000
+        limits.basic.process_time = cpu_seconds * 10_000_000
+        limits.process_memory = memory_bytes
+        if not kernel.SetInformationJobObject(job, 9, ctypes.byref(limits), ctypes.sizeof(limits)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        lifetime = kernel.CreateJobObjectW(None, None)
+        if lifetime is None:
+            raise ctypes.WinError(ctypes.get_last_error())
+        handles.append(lifetime)
+        lifetime_limits = ExtendedLimits()
+        lifetime_limits.basic.flags = 0x2000
+        if not kernel.SetInformationJobObject(
+            lifetime, 9, ctypes.byref(lifetime_limits), ctypes.sizeof(lifetime_limits)
+        ):
+            raise ctypes.WinError(ctypes.get_last_error())
+        for inherited in (gate, job):
+            os.set_handle_inheritable(inherited, True)
+        startup = subprocess.STARTUPINFO(lpAttributeList={"handle_list": [gate, job]})
+        environment = dict(environment)
+        environment["__PYVENV_LAUNCHER__"] = sys.executable
+        command = [
+            os.path.join(sys.base_prefix, "python.exe"),
+            "-S",
+            str(Path(__file__).with_name("_worker_bootstrap.py")),
+            entrypoint,
+            str(gate),
+            str(job),
+            str(memory_bytes),
+            str(cpu_seconds),
+        ]
+        if spawn_arguments is not None:
+            command.extend(str(value) for value in spawn_arguments)
+        process = subprocess.Popen(
+            command,
+            stdin=subprocess.PIPE if entrypoint == "pdf" else subprocess.DEVNULL,
+            stdout=subprocess.PIPE if entrypoint == "pdf" else None,
+            stderr=subprocess.DEVNULL if entrypoint == "pdf" else None,
+            env=environment,
+            startupinfo=startup,
+            close_fds=True,
+            creationflags=0x08000000,
+        )
+        process_handle = getattr(process, "_handle", None)
+        if not isinstance(process_handle, int):
+            raise OSError("true Windows worker handle unavailable")
+        if not kernel.AssignProcessToJobObject(job, process_handle):
+            raise ctypes.WinError(ctypes.get_last_error())
+        guard = _start_windows_cpu_guard(
+            cpu_seconds, lifetime, target_process_handle=process_handle
+        )
+        if not kernel.AssignProcessToJobObject(lifetime, process_handle):
+            raise ctypes.WinError(ctypes.get_last_error())
+        supervisor = _WindowsWorkerSupervisor(process_handle, guard, cpu_seconds)
+        if not kernel.SetEvent(gate):
+            raise ctypes.WinError(ctypes.get_last_error())
+        return process, supervisor
+    except BaseException:
+        if process is not None:
+            process.kill()
+            process.wait(timeout=1)
+        if supervisor is not None:
+            supervisor.close()
+        elif guard is not None:
+            guard.kill()
+            guard.wait(timeout=1)
+        raise
+    finally:
+        for handle in reversed(handles):
+            kernel.CloseHandle(handle)
