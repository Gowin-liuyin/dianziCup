@@ -0,0 +1,39 @@
+"""Fixed Windows worker gate; site runs only after the parent owns resource supervision."""
+
+import sys
+
+
+def main() -> None:
+    import _winapi
+
+    entrypoint = sys.argv[1]
+    if entrypoint not in ("pdf", "semantic"):
+        raise ValueError("unknown fixed worker entrypoint")
+    gate, job, memory_bytes, cpu_seconds = map(int, sys.argv[2:6])
+    if _winapi.WaitForSingleObject(gate, 3000) != _winapi.WAIT_OBJECT_0:
+        raise OSError("early worker supervision was not ready")
+    _winapi.CloseHandle(gate)
+    from pathlib import Path
+
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+    from ai_intel.infrastructure import process_limits
+
+    process_limits._EARLY_RESOURCE_LIMIT = (memory_bytes, cpu_seconds, job)
+    import site
+
+    site.main()
+    if entrypoint == "pdf":
+        import runpy
+
+        sys.argv = ["ai_intel.ingestion.parsing._pdf_worker"]
+        runpy.run_module(sys.argv[0], run_name="__main__")
+    else:
+        parent_pid, pipe_handle = map(int, sys.argv[6:8])
+        sys.argv = ["semantic-worker", "--multiprocessing-fork"]
+        from multiprocessing.spawn import spawn_main
+
+        spawn_main(parent_pid=parent_pid, pipe_handle=pipe_handle)
+
+
+if __name__ == "__main__":
+    main()
