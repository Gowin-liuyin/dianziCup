diff --git a/backend/tests/unit/test_r20_early_cpu_bootstrap.py b/backend/tests/unit/test_r20_early_cpu_bootstrap.py
new file mode 100644
index 0000000..116afbe
--- /dev/null
+++ b/backend/tests/unit/test_r20_early_cpu_bootstrap.py
@@ -0,0 +1,373 @@
+"""Product-entry observations retain default coverage and cumulative Windows CPU."""
+
+from __future__ import annotations
+
+import ctypes
+import json
+import multiprocessing
+import os
+import subprocess
+import sys
+import time
+from ctypes import wintypes
+from multiprocessing.connection import Connection
+from pathlib import Path
+
+import pytest
+
+from ai_intel.infrastructure import process_limits
+from ai_intel.infrastructure.models import semantic
+
+
+def _fixture_worker(connection: Connection, workload: str, trigger_name: str | None = None) -> None:
+    """Synthetic test payload only; no model, service or downloaded code is invoked."""
+    import coverage
+
+    leaf = None
+    if workload in ("python-gil-held", "native-gil-held-idle", "native-cpu"):
+        leaf = subprocess.Popen(
+            [
+                os.path.join(sys.base_prefix, "python.exe"),
+                "-I",
+                "-S",
+                "-c",
+                "import time;time.sleep(8)",
+            ],
+            creationflags=0x08000000,
+        )
+    connection.send(
+        (
+            "ready",
+            os.getpid(),
+            None if leaf is None else leaf.pid,
+            coverage.Coverage.current() is not None,
+            time.process_time(),
+        )
+    )
+    if trigger_name is not None:
+        kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+        kernel.OpenEventW.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.LPCWSTR]
+        kernel.OpenEventW.restype = wintypes.HANDLE
+        kernel.SetEvent.argtypes = [wintypes.HANDLE]
+        kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+        trigger = kernel.OpenEventW(2, False, trigger_name)
+        assert trigger is not None and kernel.SetEvent(trigger)
+        kernel.CloseHandle(trigger)
+    if workload in ("python-gil-held", "normal-cpu"):
+        sys.setswitchinterval(60)
+        while time.process_time() < 2.25:
+            pass
+    elif workload == "native-gil-held-idle":
+        ctypes.PyDLL("kernel32").Sleep(2000)
+    elif workload == "native-cpu":
+        import hashlib
+
+        hashlib.pbkdf2_hmac("sha256", b"a", b"b", 100_000_000)
+    elif workload == "normal-idle":
+        ctypes.PyDLL("kernel32").Sleep(200)
+    connection.send(("result", sum(range(100_000))))
+    connection.close()
+
+
+def _semantic_fixture_ok(connection: Connection, *arguments: object) -> None:
+    """One exact normalized synthetic vector exercises only the real spawn/Pipe protocol."""
+    import coverage
+
+    assert coverage.Coverage.current() is not None
+    connection.send(("ok", [[1.0] + [0.0] * 383]))
+    connection.close()
+
+
+def _semantic_fixture_eof(connection: Connection, *arguments: object) -> None:
+    connection.close()
+
+
+def _cpu_kernel() -> ctypes.WinDLL:
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.GetProcessTimes.argtypes = [wintypes.HANDLE] + [ctypes.c_void_p] * 4
+    kernel.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+    kernel.OpenProcess.restype = wintypes.HANDLE
+    kernel.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    return kernel
+
+
+@pytest.mark.parametrize(
+    "workload",
+    ["short", "python-gil-held", "native-gil-held-idle", "native-cpu", "normal-cpu", "normal-idle"],
+)
+def test_fixed_early_spawn_keeps_original_cpu_and_result_boundary(
+    workload: str, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    if sys.platform != "win32":
+        return
+    fault = workload in ("python-gil-held", "native-gil-held-idle", "native-cpu")
+    if fault:
+        monkeypatch.setattr(
+            process_limits,
+            "_WINDOWS_CPU_GUARD_CODE",
+            process_limits._WINDOWS_CPU_GUARD_CODE.replace(
+                "    while True:\n",
+                "    import time,os\n    time.sleep(0.4)\n    os._exit(99)\n    while True:\n",
+            ),
+        )
+    monkeypatch.setattr(semantic, "MAX_MEMORY_BYTES", 100 * 1024**2)
+    monkeypatch.setattr(semantic, "MAX_CPU_SECONDS", 1)
+    receiving, sending = multiprocessing.get_context("spawn").Pipe(duplex=False)
+    process = semantic._EarlySemanticProcess(
+        target=_fixture_worker, args=(sending, workload), daemon=True
+    )
+    kernel = _cpu_kernel()
+    handles: list[int] = []
+    messages: list[object] = []
+    try:
+        process.start()
+        sending.close()
+        supervision = process._popen.supervisor
+        guard_handle = kernel.OpenProcess(0x100000 | 0x1000, False, supervision.guard.pid)
+        assert guard_handle is not None
+        handles.append(guard_handle)
+        assert receiving.poll(8), "worker did not produce a readiness or EOF within original 8s"
+        ready = receiving.recv()
+        assert ready[0] == "ready"
+        assert ready[3] is True, "actual worker coverage tracing must remain active"
+        if ready[2] is not None:
+            leaf_handle = kernel.OpenProcess(0x100000 | 0x1000, False, ready[2])
+            assert leaf_handle is not None
+            handles.append(leaf_handle)
+        process.join(timeout=8)
+        assert not process.is_alive()
+        while True:
+            try:
+                if not receiving.poll(0):
+                    break
+                messages.append(receiving.recv())
+            except (EOFError, BrokenPipeError):
+                break
+        ticks = process_limits._read_windows_cpu_ticks(kernel, process.sentinel)
+        observation = {
+            "workload": workload,
+            "ready": ready,
+            "final_cpu_seconds": ticks / 10_000_000,
+            "worker_exitcode": process.exitcode,
+            "guard_exitcode": supervision.guard.poll(),
+            "messages": messages,
+            "parent_supervision_error": str(supervision.error) if supervision.error else None,
+            "parent_last_cpu_seconds": supervision.last_cpu_ticks / 10_000_000,
+        }
+        print("EARLY_OBSERVATION " + json.dumps(observation))
+        assert all(kernel.WaitForSingleObject(handle, 1000) == 0 for handle in handles)
+        if workload in ("short", "normal-idle"):
+            assert messages == [("result", 4_999_950_000)]
+            assert process.exitcode == 0
+        else:
+            assert messages == []
+            assert ticks < 10_000_000
+    finally:
+        if process.pid is not None:
+            if process.is_alive():
+                process.kill()
+                process.join(timeout=1)
+            process.close()
+        receiving.close()
+        sending.close()
+        for handle in handles:
+            kernel.CloseHandle(handle)
+
+
+def test_real_get_process_times_failure_reports_win32_invalid_handle(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    if sys.platform != "win32":
+        return
+    kernel = _cpu_kernel()
+    kernel.CreateEventW.argtypes = [ctypes.c_void_p, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR]
+    kernel.CreateEventW.restype = wintypes.HANDLE
+    ready = kernel.CreateEventW(None, True, False, None)
+    lifetime = kernel.CreateEventW(None, True, False, None)
+    assert ready is not None and lifetime is not None
+    monkeypatch.setattr(sys, "argv", ["guard", "0", str(ready), str(lifetime), "10000000"])
+    with pytest.raises(OSError) as captured:
+        exec(process_limits._WINDOWS_CPU_GUARD_CODE, {})
+    assert captured.value.winerror == 6
+    print(
+        "REAL_API_FAILURE "
+        + json.dumps({"api": "GetProcessTimes", "winerror": captured.value.winerror})
+    )
+
+
+@pytest.mark.parametrize("response", ["ok", "eof"])
+def test_product_semantic_real_spawn_pipe_accepts_fixture_and_rejects_eof(
+    response: str, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    monkeypatch.setattr(
+        semantic,
+        "_semantic_worker",
+        _semantic_fixture_ok if response == "ok" else _semantic_fixture_eof,
+    )
+    client = semantic.LocalSemanticModels(tmp_path)
+    if response == "ok":
+        result = client.embed_query("explicit synthetic fixture")
+        assert result.vectors == (tuple([1.0] + [0.0] * 383),)
+    else:
+        with pytest.raises(semantic.SemanticRuntimeError, match="exited without a result"):
+            client.embed_query("explicit synthetic EOF fixture")
+
+
+def test_fixed_bootstrap_rejects_unlisted_entrypoint_before_launch(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    def forbidden_launch(*args: object, **kwargs: object) -> None:
+        pytest.fail("unlisted entrypoint reached process creation")
+
+    monkeypatch.setattr(process_limits.subprocess, "Popen", forbidden_launch)
+    with pytest.raises(OSError, match="unavailable"):
+        process_limits._launch_windows_worker(
+            "arbitrary", memory_bytes=100 * 1024**2, cpu_seconds=1, environment={}
+        )
+
+
+def test_semantic_result_is_rejected_when_final_supervision_fails(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    from test_r05_semantic import WorkerContext, WorkerProcess
+
+    class LateFailedProcess(WorkerProcess):
+        supervision_error: OSError | None = None
+
+        def close(self) -> None:
+            super().close()
+            self.supervision_error = OSError("final cumulative CPU query failed")
+
+    context = WorkerContext(("ok", [[1.0] + [0.0] * 383]))
+    context.process = LateFailedProcess()
+    monkeypatch.setattr(semantic, "_EarlySemanticProcess", LateFailedProcess)
+    monkeypatch.setattr(semantic.multiprocessing, "get_context", lambda *args: context)
+    with pytest.raises(semantic.SemanticRuntimeError, match="resource supervision failed"):
+        semantic.LocalSemanticModels(tmp_path).embed_query("explicit valid synthetic input")
+    assert context.process.closed and not semantic._WORKER_LOCK.locked()
+
+
+@pytest.mark.parametrize("workload", ["python-gil-held", "native-gil-held-idle", "native-cpu"])
+def test_body_ready_guard_fault_is_additional_to_early_ready_fault(
+    workload: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    if sys.platform != "win32":
+        return
+    import uuid
+
+    kernel = _cpu_kernel()
+    kernel.CreateEventW.argtypes = [ctypes.c_void_p, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR]
+    kernel.CreateEventW.restype = wintypes.HANDLE
+    trigger_name = "Local\\R20BodyFault_" + uuid.uuid4().hex
+    trigger = kernel.CreateEventW(None, True, False, trigger_name)
+    assert trigger is not None
+    trigger_code = (
+        "    kernel.OpenEventW.argtypes=[wintypes.DWORD,wintypes.BOOL,wintypes.LPCWSTR]\n"
+        "    kernel.OpenEventW.restype=wintypes.HANDLE\n"
+        f"    trigger=kernel.OpenEventW(0x100000,False,{trigger_name!r})\n"
+        "    if not trigger or kernel.WaitForSingleObject(trigger,3000)!=0:\n"
+        "        raise OSError('test trigger unavailable')\n"
+        "    kernel.CloseHandle(trigger)\n"
+        "    import time,os\n    time.sleep(0.4)\n    os._exit(99)\n"
+    )
+    monkeypatch.setattr(
+        process_limits,
+        "_WINDOWS_CPU_GUARD_CODE",
+        process_limits._WINDOWS_CPU_GUARD_CODE.replace(
+            "    while True:\n", trigger_code + "    while True:\n"
+        ),
+    )
+    monkeypatch.setattr(semantic, "MAX_MEMORY_BYTES", 100 * 1024**2)
+    monkeypatch.setattr(semantic, "MAX_CPU_SECONDS", 1)
+    receiving, sending = multiprocessing.get_context("spawn").Pipe(duplex=False)
+    process = semantic._EarlySemanticProcess(
+        target=_fixture_worker, args=(sending, workload, trigger_name), daemon=True
+    )
+    handles: list[int] = []
+    messages: list[object] = []
+    try:
+        process.start()
+        sending.close()
+        assert receiving.poll(8)
+        ready = receiving.recv()
+        assert ready[0] == "ready" and ready[3] is True
+        supervision = process._popen.supervisor
+        for pid in (supervision.guard.pid, ready[2]):
+            handle = kernel.OpenProcess(0x100000 | 0x1000, False, pid)
+            assert handle is not None
+            handles.append(handle)
+        process.join(timeout=8)
+        assert not process.is_alive()
+        while True:
+            try:
+                if not receiving.poll(0):
+                    break
+                messages.append(receiving.recv())
+            except (EOFError, BrokenPipeError):
+                break
+        assert all(kernel.WaitForSingleObject(handle, 1000) == 0 for handle in handles)
+        ticks = process_limits._read_windows_cpu_ticks(kernel, process.sentinel)
+        print(
+            "BODY_FAULT_OBSERVATION "
+            + json.dumps(
+                {
+                    "workload": workload,
+                    "ready": ready,
+                    "final_cpu_seconds": ticks / 10_000_000,
+                    "guard_exitcode": supervision.guard.poll(),
+                    "worker_exitcode": process.exitcode,
+                    "messages": messages,
+                    "parent_error": str(supervision.error),
+                    "parent_last_cpu_seconds": supervision.last_cpu_ticks / 10_000_000,
+                }
+            )
+        )
+        assert messages == []
+        assert ticks < 10_000_000
+    finally:
+        if process.pid is not None:
+            if process.is_alive():
+                process.kill()
+                process.join(timeout=1)
+            process.close()
+        receiving.close()
+        sending.close()
+        for handle in handles:
+            kernel.CloseHandle(handle)
+        kernel.CloseHandle(trigger)
+
+
+@pytest.mark.parametrize("boundary", ["exhausted", "near"])
+def test_real_initial_cpu_and_near_budget_readiness_remain_cumulative(boundary: str) -> None:
+    target = 1.015625 if boundary == "exhausted" else 0.9375
+    code = (
+        "import os,time\nfrom ai_intel.infrastructure import process_limits\n"
+        f"while time.process_time() < {target}: pass\n"
+        "print('PREBOUND',time.process_time(),flush=True)\n"
+        "handle=process_limits.bound_process_resources(memory_bytes=100*1024**2,cpu_seconds=1)\n"
+        "print('READY',time.process_time(),flush=True)\n"
+    )
+    result = subprocess.run(
+        [sys.executable, "-c", code], capture_output=True, timeout=8, check=False
+    )
+    print(
+        "STARTUP_BOUNDARY "
+        + json.dumps(
+            {
+                "boundary": boundary,
+                "returncode": result.returncode,
+                "stdout": result.stdout.decode("utf-8", "replace"),
+                "stderr": result.stderr.decode("utf-8", "replace"),
+            }
+        )
+    )
+    if boundary == "exhausted":
+        assert b"PREBOUND" in result.stdout and b"READY" not in result.stdout
+        assert result.returncode != 0
+    else:
+        assert result.returncode == 0 and b"READY" in result.stdout
+        cpu = float(result.stdout.split(b"READY ")[1].split()[0])
+        assert 0.9375 <= cpu < 1
