+class _EarlySemanticProcess(SpawnProcess):
+    """Use the standard Windows spawn serialization behind the fixed early gate."""
+
+    _supervisor: _WindowsWorkerSupervisor | None = None
+
+    @staticmethod
+    def _Popen(process_object: BaseProcess) -> WindowsSpawnPopen:
+        import _winapi
+        import msvcrt
+        from multiprocessing import reduction, spawn, util
+        from multiprocessing.context import set_spawning_popen
+        from multiprocessing.popen_spawn_win32 import Popen
+
+        from ai_intel.infrastructure.process_limits import _launch_windows_worker
+
+        class EarlyPopen(Popen):
+            def __init__(self) -> None:
+                preparation = spawn.get_preparation_data(process_object.name)
+                reading_handle, writing_handle = _winapi.CreatePipe(None, 0)
+                worker = None
+                supervisor = None
+                try:
+                    with open(msvcrt.open_osfhandle(writing_handle, 0), "wb") as stream:
+                        worker, supervisor = _launch_windows_worker(
+                            "semantic",
+                            memory_bytes=MAX_MEMORY_BYTES,
+                            cpu_seconds=MAX_CPU_SECONDS,
+                            environment=dict(os.environ),
+                            spawn_arguments=(os.getpid(), reading_handle),
+                        )
+                        handle = getattr(worker, "_handle", None)
+                        if not isinstance(handle, int):
+                            raise OSError("true semantic worker handle unavailable")
+                        self.pid = worker.pid
+                        self.returncode = None
+                        self.supervisor = supervisor
+                        self._handle = reduction.duplicate(handle)
+                        self.sentinel = int(self._handle)
+                        self.finalizer = util.Finalize(
+                            self,
+                            self._finish,
+                            (worker, supervisor, self.sentinel, reading_handle),
+                        )
+                        set_spawning_popen(self)
+                        try:
+                            reduction.dump(preparation, stream)
+                            reduction.dump(process_object, stream)
+                        finally:
+                            set_spawning_popen(None)
+                        if isinstance(process_object, _EarlySemanticProcess):
+                            process_object._supervisor = supervisor
+                except BaseException:
+                    if worker is not None:
+                        worker.kill()
+                        worker.wait(timeout=1)
+                    if hasattr(self, "finalizer"):
+                        self.finalizer()
+                    else:
+                        if supervisor is not None:
+                            supervisor.close()
+                        _winapi.CloseHandle(reading_handle)
+                    raise
+
+            @staticmethod
+            def _finish(
+                worker: subprocess.Popen[bytes],
+                supervisor: _WindowsWorkerSupervisor,
+                worker_handle: int,
+                reading_handle: int,
+            ) -> None:
+                try:
+                    worker.wait(timeout=1)
+                    supervisor.close()
+                finally:
+                    _winapi.CloseHandle(worker_handle)
+                    _winapi.CloseHandle(reading_handle)
+
+        return EarlyPopen()
+
+    @property
+    def supervision_error(self) -> OSError | None:
+        return None if self._supervisor is None else self._supervisor.error
+
