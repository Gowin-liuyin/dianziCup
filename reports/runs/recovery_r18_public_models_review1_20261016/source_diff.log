diff --git a/sdk/python/ai_intel_client/models.py b/sdk/python/ai_intel_client/models.py
index 4ea0880a..01e32fec 100644
--- a/sdk/python/ai_intel_client/models.py
+++ b/sdk/python/ai_intel_client/models.py
@@ -308,3 +308,280 @@ class StackUploadRequest(PublicRecord):
     format: Literal[
         "requirements_txt", "package_lock", "sbom_cyclonedx", "json_components", "csv_components"
     ]
+
+
+Severity = Literal["none", "low", "medium", "high", "critical"]
+MinimumSeverity = Literal["low", "medium", "high", "critical"]
+Cursor = Annotated[str, Field(min_length=1, max_length=2048)]
+StepName = Annotated[str, Field(min_length=1, max_length=500)]
+SEVERITY_RANK: dict[str, int] = {"none": 0, "low": 1, "medium": 2, "high": 3, "critical": 4}
+
+
+class RiskFinding(PublicRecord):
+    component_index: int = Field(ge=0, le=199)
+    event_id: PublicUuid
+    assessment_id: PublicUuid
+    rule_id: PublicUuid
+    rule_version: int = Field(ge=1)
+    grading_claim_id: PublicUuid
+    severity: Severity
+    cvss_score: float = Field(ge=0, le=10, allow_inf_nan=False)
+    cvss_version: Literal["2.0", "3.0", "3.1", "4.0"]
+    citations: tuple[Citation, ...] = Field(min_length=1, max_length=100)
+    freshness: Literal["current"]
+
+    @model_validator(mode="after")
+    def require_consistent_grade(self) -> RiskFinding:
+        score = self.cvss_score
+        if score == 0:
+            severity = "none"
+        elif score < 4:
+            severity = "low"
+        elif score < 7:
+            severity = "medium"
+        elif score < 9:
+            severity = "high"
+        else:
+            severity = "critical"
+        if self.severity != severity:
+            raise ValueError("CVSS score and normalized severity disagree")
+        return self
+
+
+class RiskSummary(PublicRecord):
+    policy_version: Literal["r18-risk-policy-1"]
+    minimum_severity: MinimumSeverity
+    confirmation: Literal["confirmed", "none_confirmed", "unknown", "conflict"]
+    coverage: Literal["complete", "partial", "unknown"]
+    freshness: Freshness
+    evaluated_components: int = Field(ge=0, le=200)
+    unknown_component_indices: tuple[Annotated[int, Field(ge=0, le=199)], ...] = Field(
+        max_length=200
+    )
+    findings: tuple[RiskFinding, ...] = Field(max_length=200)
+
+    @model_validator(mode="after")
+    def require_consistent_confirmation(self) -> RiskSummary:
+        if len(set(self.unknown_component_indices)) != len(self.unknown_component_indices):
+            raise ValueError("unknown component indices must be unique")
+        identities: set[tuple[int, UUID, UUID, UUID, int, UUID]] = set()
+        assessment_bindings: dict[UUID, tuple[int, UUID, UUID, int]] = {}
+        claim_bindings: dict[UUID, tuple[UUID, float, str]] = {}
+        for finding in self.findings:
+            identity = (
+                finding.component_index,
+                finding.event_id,
+                finding.assessment_id,
+                finding.rule_id,
+                finding.rule_version,
+                finding.grading_claim_id,
+            )
+            if identity in identities:
+                raise ValueError("risk findings must be unique")
+            identities.add(identity)
+            assessment_binding = (
+                finding.component_index,
+                finding.event_id,
+                finding.rule_id,
+                finding.rule_version,
+            )
+            if assessment_bindings.setdefault(finding.assessment_id, assessment_binding) != (
+                assessment_binding
+            ):
+                raise ValueError("one assessment has inconsistent component or event bindings")
+            claim_binding = (finding.event_id, finding.cvss_score, finding.cvss_version)
+            if claim_bindings.setdefault(finding.grading_claim_id, claim_binding) != claim_binding:
+                raise ValueError("one grading claim has inconsistent event or score bindings")
+        has_confirmed = any(
+            SEVERITY_RANK[finding.severity] >= SEVERITY_RANK[self.minimum_severity]
+            for finding in self.findings
+        )
+        if (self.confirmation == "confirmed") != has_confirmed:
+            raise ValueError("risk confirmation disagrees with threshold findings")
+        if self.coverage == "complete" and (
+            self.unknown_component_indices or self.freshness != "current"
+        ):
+            raise ValueError("complete coverage cannot contain unknown or stale components")
+        return self
+
+
+class StackCheckEnvelope(PublicRecord):
+    result: StackCheckResult
+    risk_summary: RiskSummary
+
+    @model_validator(mode="after")
+    def require_assessment_scope(self) -> StackCheckEnvelope:
+        assessments = self.result.results
+        summary = self.risk_summary
+        if summary.coverage == "complete" and not assessments:
+            raise ValueError("empty result scope cannot establish complete coverage")
+        if summary.evaluated_components > len(assessments):
+            raise ValueError("evaluated component count exceeds the returned scope")
+        if any(index >= len(assessments) for index in summary.unknown_component_indices):
+            raise ValueError("unknown component index is outside the returned scope")
+        for finding in summary.findings:
+            if finding.component_index >= len(assessments):
+                raise ValueError("finding component index is outside the returned scope")
+            assessment = assessments[finding.component_index]
+            if (
+                assessment.assessment_id != finding.assessment_id
+                or assessment.status != "supported_applicability"
+                or assessment.freshness != "current"
+                or not assessment.citations
+            ):
+                raise ValueError("finding requires the same current supported assessment")
+        unknown_indices = {
+            index
+            for index, assessment in enumerate(assessments)
+            if assessment.status in {"insufficient_evidence", "conflicting_evidence"}
+            or assessment.freshness != "current"
+        }
+        if not unknown_indices.issubset(summary.unknown_component_indices):
+            raise ValueError("risk summary omits unknown or conflicting component results")
+        if summary.coverage == "complete" and unknown_indices:
+            raise ValueError("unknown assessments cannot have complete coverage")
+        return self
+
+
+class VulnerabilityPage(PublicRecord):
+    items: tuple[Vulnerability, ...] = Field(max_length=100)
+    next_cursor: Cursor | None
+    data_mode: DataMode
+
+    @model_validator(mode="after")
+    def require_unique_events(self) -> VulnerabilityPage:
+        event_ids = [item.event_id for item in self.items]
+        if len(set(event_ids)) != len(event_ids):
+            raise ValueError("vulnerability page event IDs must be unique")
+        return self
+
+
+class VulnerabilityDetailPage(PublicRecord):
+    vulnerability: Vulnerability
+    advisories: tuple[Advisory, ...] = Field(max_length=100)
+    next_cursor: Cursor | None
+    mapping_limits: tuple[StepName, ...] = Field(max_length=100)
+    data_mode: DataMode
+
+
+class SourceDescriptor(PublicRecord):
+    source_id: Annotated[str, Field(min_length=1, max_length=200)]
+    name: StepName
+    category: Literal[
+        "structured_vulnerability",
+        "vendor_advisory",
+        "security_community",
+        "code_repository",
+        "technical_blog",
+        "academic_paper",
+        "technical_standard",
+        "policy_regulation",
+    ]
+    enabled: bool
+    health: Literal["never_polled", "healthy", "partial", "failed", "blocked", "unknown"]
+    last_attempt_at: PublicDateTime | None
+    last_success_at: PublicDateTime | None
+    reason_code: Annotated[str, Field(min_length=1, max_length=100)] | None
+    data_mode: DataMode
+
+    @model_validator(mode="after")
+    def require_observed_health(self) -> SourceDescriptor:
+        if self.health == "healthy" and self.last_success_at is None:
+            raise ValueError("healthy sources require an actual successful observation")
+        if self.health == "never_polled" and (
+            self.last_attempt_at is not None or self.last_success_at is not None
+        ):
+            raise ValueError("never-polled sources cannot have polling observations")
+        return self
+
+
+class SourcePage(PublicRecord):
+    items: tuple[SourceDescriptor, ...] = Field(max_length=100)
+    next_cursor: Cursor | None
+    data_mode: DataMode
+
+    @model_validator(mode="after")
+    def require_unique_sources(self) -> SourcePage:
+        if any(item.data_mode != self.data_mode for item in self.items):
+            raise ValueError("source page and item data modes must agree")
+        source_ids = [item.source_id for item in self.items]
+        if len(set(source_ids)) != len(source_ids):
+            raise ValueError("source page IDs must be unique")
+        return self
+
+
+class TaskDescriptor(PublicRecord):
+    task_id: PublicUuid
+    task_type: Literal["ask", "stack_check"]
+    status: Literal[
+        "queued",
+        "running",
+        "retry_wait",
+        "waiting_approval",
+        "succeeded",
+        "partial",
+        "failed",
+        "cancelled",
+        "blocked",
+    ]
+    poll_uri: Annotated[
+        str,
+        Field(
+            pattern=r"^/api/v1/tasks/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}"
+            r"-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
+        ),
+    ]
+    created_at: PublicDateTime
+    updated_at: PublicDateTime
+
+    @model_validator(mode="after")
+    def require_bound_task_identity(self) -> TaskDescriptor:
+        if self.poll_uri != f"/api/v1/tasks/{self.task_id}":
+            raise ValueError("task polling URI does not match its ID")
+        if self.updated_at < self.created_at:
+            raise ValueError("task update precedes creation")
+        return self
+
+
+class PublicProblem(PublicRecord):
+    type: AbsoluteUri
+    title: StepName
+    status: int = Field(ge=400, le=599)
+    error: Annotated[str, Field(min_length=1, max_length=100)]
+    trace_id: PublicUuid
+
+
+class TaskResultEnvelope(PublicRecord):
+    task: TaskDescriptor
+    result: QAAnswer | StackCheckEnvelope | None
+    error: PublicProblem | None
+    completed_steps: tuple[StepName, ...] = Field(max_length=100)
+    pending_steps: tuple[StepName, ...] = Field(max_length=100)
+    failed_steps: tuple[StepName, ...] = Field(max_length=100)
+
+    @model_validator(mode="after")
+    def require_task_result_consistency(self) -> TaskResultEnvelope:
+        steps = (self.completed_steps, self.pending_steps, self.failed_steps)
+        if any(len(set(values)) != len(values) for values in steps):
+            raise ValueError("task step lists must be unique")
+        combined = tuple(step for values in steps for step in values)
+        if len(set(combined)) != len(combined):
+            raise ValueError("one step cannot have multiple current states")
+        if self.result is not None and (
+            (self.task.task_type == "ask") != isinstance(self.result, QAAnswer)
+        ):
+            raise ValueError("result does not match its task type")
+        status = self.task.status
+        if status in {"queued", "running", "retry_wait", "waiting_approval"} and (
+            self.result is not None or self.error is not None
+        ):
+            raise ValueError("pending tasks cannot have a completed result or error")
+        if status == "succeeded" and (
+            self.result is None or self.error is not None or self.pending_steps or self.failed_steps
+        ):
+            raise ValueError("succeeded tasks require only a completed result")
+        if status in {"failed", "cancelled", "blocked"} and (
+            self.result is not None or self.error is None
+        ):
+            raise ValueError("unsuccessful terminal tasks require only an explicit problem")
+        return self
diff --git a/sdk/python/tests/test_public_extension_models.py b/sdk/python/tests/test_public_extension_models.py
new file mode 100644
index 00000000..38c57912
--- /dev/null
+++ b/sdk/python/tests/test_public_extension_models.py
@@ -0,0 +1,597 @@
+"""Synthetic public envelope contracts, with independent frozen-schema checks."""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Callable
+from copy import deepcopy
+from pathlib import Path
+
+import ai_intel_client
+import pytest
+from ai_intel_client.models import (
+    PublicProblem,
+    PublicRecord,
+    RiskFinding,
+    RiskSummary,
+    SourceDescriptor,
+    SourcePage,
+    StackCheckEnvelope,
+    TaskDescriptor,
+    TaskResultEnvelope,
+    VulnerabilityDetailPage,
+    VulnerabilityPage,
+)
+from jsonschema import Draft202012Validator, FormatChecker
+from pydantic import ValidationError
+
+ROOT = Path(__file__).resolve().parents[3]
+SCHEMA = json.loads((ROOT / "contracts/schemas/public_api_extensions_v1.json").read_bytes())
+IDENTIFIER = "00000000-0000-4000-8000-000000000001"
+OTHER_IDENTIFIER = "00000000-0000-4000-8000-000000000002"
+TIME = "2026-10-16T09:00:00+08:00"
+Payload = dict[str, object]
+
+
+def citation() -> Payload:
+    return {
+        "evidence_id": IDENTIFIER,
+        "revision_id": IDENTIFIER,
+        "quote": "Synthetic source explicitly grades the event.",
+        "locator": "/metrics/score",
+        "source_uri": "https://example.invalid/synthetic-advisory",
+    }
+
+
+def finding() -> Payload:
+    return {
+        "component_index": 0,
+        "event_id": IDENTIFIER,
+        "assessment_id": IDENTIFIER,
+        "rule_id": IDENTIFIER,
+        "rule_version": 1,
+        "grading_claim_id": IDENTIFIER,
+        "severity": "high",
+        "cvss_score": 7.0,
+        "cvss_version": "3.1",
+        "citations": [citation()],
+        "freshness": "current",
+    }
+
+
+def summary() -> Payload:
+    return {
+        "policy_version": "r18-risk-policy-1",
+        "minimum_severity": "high",
+        "confirmation": "confirmed",
+        "coverage": "complete",
+        "freshness": "current",
+        "evaluated_components": 1,
+        "unknown_component_indices": [],
+        "findings": [finding()],
+    }
+
+
+def stack_envelope() -> Payload:
+    return {
+        "result": {
+            "kind": "completed",
+            "results": [
+                {
+                    "component": {
+                        "ecosystem": "PyPI",
+                        "package_name": "synthetic-package",
+                        "version": "1",
+                    },
+                    "status": "supported_applicability",
+                    "reason_code": "rule_supported",
+                    "assessment_id": IDENTIFIER,
+                    "citations": [citation()],
+                    "freshness": "current",
+                }
+            ],
+            "limitations": [],
+        },
+        "risk_summary": summary(),
+    }
+
+
+def vulnerability() -> Payload:
+    return {
+        "intel_id": IDENTIFIER,
+        "event_id": IDENTIFIER,
+        "title": "Synthetic AI vulnerability",
+        "external_ids": [],
+        "enrichments": [],
+        "relations": [],
+        "freshness": "unknown",
+    }
+
+
+def source() -> Payload:
+    return {
+        "source_id": "synthetic-source",
+        "name": "Synthetic vendor",
+        "category": "vendor_advisory",
+        "enabled": True,
+        "health": "never_polled",
+        "last_attempt_at": None,
+        "last_success_at": None,
+        "reason_code": None,
+        "data_mode": "fixture",
+    }
+
+
+def task() -> Payload:
+    return {
+        "task_id": IDENTIFIER,
+        "task_type": "ask",
+        "status": "queued",
+        "poll_uri": "/api/v1/tasks/" + IDENTIFIER,
+        "created_at": TIME,
+        "updated_at": TIME,
+    }
+
+
+def problem() -> Payload:
+    return {
+        "type": "urn:dianzi:problem:not-configured",
+        "title": "Dependency unavailable",
+        "status": 503,
+        "error": "not_configured",
+        "trace_id": IDENTIFIER,
+    }
+
+
+def answer() -> Payload:
+    return {
+        "kind": "completed",
+        "answer_id": IDENTIFIER,
+        "answer_text": "Synthetic grounded answer",
+        "claims": [],
+        "citations": [],
+        "limitations": ["Synthetic fixture; no live result."],
+        "freshness": "unknown",
+        "data_mode": "fixture",
+        "started_at": TIME,
+        "completed_at": TIME,
+        "latency_milliseconds": 0,
+    }
+
+
+def task_envelope() -> Payload:
+    return {
+        "task": task(),
+        "result": None,
+        "error": None,
+        "completed_steps": [],
+        "pending_steps": ["generate"],
+        "failed_steps": [],
+    }
+
+
+def source_page() -> Payload:
+    return {"items": [source()], "next_cursor": None, "data_mode": "fixture"}
+
+
+def vulnerability_page() -> Payload:
+    return {"items": [vulnerability()], "next_cursor": None, "data_mode": "fixture"}
+
+
+def detail_page() -> Payload:
+    return {
+        "vulnerability": vulnerability(),
+        "advisories": [],
+        "next_cursor": None,
+        "mapping_limits": ["Synthetic mapping without external identifiers."],
+        "data_mode": "fixture",
+    }
+
+
+EXAMPLES: tuple[tuple[type[PublicRecord], Callable[[], Payload]], ...] = (
+    (RiskFinding, finding),
+    (RiskSummary, summary),
+    (StackCheckEnvelope, stack_envelope),
+    (VulnerabilityPage, vulnerability_page),
+    (VulnerabilityDetailPage, detail_page),
+    (SourceDescriptor, source),
+    (SourcePage, source_page),
+    (TaskDescriptor, task),
+    (PublicProblem, problem),
+    (TaskResultEnvelope, task_envelope),
+)
+
+
+def schema_valid(model: type[PublicRecord], value: Payload) -> bool:
+    validator = Draft202012Validator(
+        {**SCHEMA, "$ref": "#/$defs/" + model.__name__}, format_checker=FormatChecker()
+    )
+    return validator.is_valid(value)
+
+
+def rejected(model: type[PublicRecord], value: Payload, *, schema_rejects: bool = True) -> None:
+    if schema_rejects:
+        assert not schema_valid(model, value)
+    with pytest.raises(ValidationError):
+        model.model_validate_json(json.dumps(value))
+
+
+@pytest.mark.parametrize("model,factory", EXAMPLES)
+def test_new_models_preserve_all_frozen_fields_and_roundtrip(
+    model: type[PublicRecord], factory: Callable[[], Payload]
+) -> None:
+    value = factory()
+    assert schema_valid(model, value)
+    parsed = model.model_validate_json(json.dumps(value))
+    assert json.loads(parsed.wire_json()) == value
+    generated = model.model_json_schema()
+    approved = SCHEMA["$defs"][model.__name__]
+    assert set(generated["properties"]) == set(approved["properties"])
+    assert set(generated["required"]) == set(approved["required"])
+    assert generated["additionalProperties"] is False
+    assert getattr(ai_intel_client, model.__name__) is model
+
+
+@pytest.mark.parametrize("model,factory", EXAMPLES)
+def test_every_required_field_is_required_and_extra_fields_are_rejected(
+    model: type[PublicRecord], factory: Callable[[], Payload]
+) -> None:
+    for name in SCHEMA["$defs"][model.__name__]["required"]:
+        value = factory()
+        del value[name]
+        rejected(model, value)
+    for name in ("tenant_id", "authorization", "secret_ref", "skip_validation"):
+        rejected(model, {**factory(), name: "forged"})
+
+
+@pytest.mark.parametrize(
+    "severity,score,valid",
+    [
+        ("none", 0, True),
+        ("none", 0.1, False),
+        ("low", 0, False),
+        ("low", 0.1, True),
+        ("low", 3.999, True),
+        ("low", 4, False),
+        ("medium", 4, True),
+        ("medium", 6.999, True),
+        ("medium", 7, False),
+        ("high", 7, True),
+        ("high", 8.999, True),
+        ("high", 9, False),
+        ("critical", 9, True),
+        ("critical", 10, True),
+        ("critical", 10.1, False),
+    ],
+)
+def test_cvss_normalized_grade_boundaries(severity: str, score: float, valid: bool) -> None:
+    value = {**finding(), "severity": severity, "cvss_score": score}
+    assert schema_valid(RiskFinding, value) is valid
+    if valid:
+        assert RiskFinding.model_validate_json(json.dumps(value)).severity == severity
+    else:
+        rejected(RiskFinding, value)
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("component_index", True),
+        ("component_index", "0"),
+        ("component_index", -1),
+        ("component_index", 200),
+        ("rule_version", True),
+        ("rule_version", "1"),
+        ("rule_version", 0),
+        ("cvss_score", True),
+        ("cvss_score", "7"),
+        ("cvss_score", float("inf")),
+        ("cvss_score", float("nan")),
+        ("cvss_version", "5.0"),
+        ("freshness", "stale"),
+        ("citations", []),
+        ("event_id", IDENTIFIER.replace("-", "")),
+        ("grading_claim_id", "not-a-uuid"),
+    ],
+)
+def test_risk_finding_strict_bounds_and_traceability(field: str, value: object) -> None:
+    rejected(RiskFinding, {**finding(), field: value}, schema_rejects=False)
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("enabled", 1),
+        ("enabled", "true"),
+        ("source_id", ""),
+        ("source_id", "s" * 201),
+        ("name", "s" * 501),
+        ("category", "unregistered"),
+        ("reason_code", ""),
+        ("reason_code", "s" * 101),
+        ("data_mode", "mock"),
+        ("last_attempt_at", "2026-10-16T00:00:00"),
+        ("last_attempt_at", "2026-02-30T00:00:00Z"),
+        ("last_attempt_at", 42),
+        ("last_success_at", "2026-10-16 00:00:00Z"),
+    ],
+)
+def test_source_strict_types_and_formats(field: str, value: object) -> None:
+    rejected(SourceDescriptor, {**source(), field: value})
+
+
+def test_enabled_is_not_a_successful_poll_and_health_uses_observations() -> None:
+    parsed = SourceDescriptor.model_validate_json(json.dumps(source()))
+    assert parsed.enabled and parsed.health == "never_polled"
+    rejected(SourceDescriptor, {**source(), "health": "healthy"}, schema_rejects=False)
+    rejected(SourceDescriptor, {**source(), "last_attempt_at": TIME}, schema_rejects=False)
+    value = {**source(), "health": "healthy", "last_attempt_at": TIME, "last_success_at": TIME}
+    assert SourceDescriptor.model_validate_json(json.dumps(value)).health == "healthy"
