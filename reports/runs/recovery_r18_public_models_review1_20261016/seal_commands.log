dependencies = [
    "alembic>=1.14,<2.0",
    "argon2-cffi>=23.1,<26.0",
    "fastapi>=0.115,<1.0",
    "psycopg[binary]>=3.2,<4.0",
    "sqlalchemy>=2.0.36,<3.0",
    "uvicorn>=0.32,<1.0",
    "pydantic>=2.10,<3.0",
    "pydantic-settings>=2.7,<3.0",
    "celery[redis]>=5.4,<6",
    "redis>=5.2,<7",
    "httpx>=0.28,<1",
    "minio==7.2.20",
    "dnspython>=2.9,<3",
    "pypdf>=6.20.1,<7",
    "pgvector==0.5.1",
    "packaging>=26.3,<27",
    "semver>=3,<4",
    "packageurl-python==0.17.6",
    "pyyaml==6.0.3",
    "neo4j==6.4.0",
    "mcp==2.3.0",
    "tiktoken==0.14.0",
    "langgraph==1.2.15",
    "langgraph-checkpoint-postgres==3.2.0",
]

[project.optional-dependencies]
semantic = [
    "onnxruntime==1.24.4",
    "tokenizers==0.22.2",
    "numpy==2.4.2",
]

[dependency-groups]
dev = [
    "httpx>=0.28,<1.0",
    "pytest>=8.3,<9.0",
    "pytest-cov>=6.0,<7.0",
    "ruff>=0.8,<1.0",
    "mypy>=1.13,<2.0",
    "jsonschema[format-nongpl]>=4.23,<5",
    "types-pyyaml==6.0.12.20260906",
    "types-jsonschema==4.26.0.20261006",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/ai_intel"]

[tool.ruff]
line-length = 100
target-version = "py312"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "RUF"]
# RUF001/002/003 将中文文档注释的全角标点判为歧义字符, 与 AGENTS.md 规定的中文 docstring 风格冲突;
