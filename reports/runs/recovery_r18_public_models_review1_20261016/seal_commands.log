        time.sleep(0.05)
        return original_decode(*args, **kwargs)

    async with DianziClient(
        "http://127.0.0.1:43217",
        SecretStr(KEY),
        question_deadline_seconds=0.02,
        async_transport=httpx.MockTransport(lambda _: httpx.Response(200, json=ANSWER)),
    ) as backend:
        with (
