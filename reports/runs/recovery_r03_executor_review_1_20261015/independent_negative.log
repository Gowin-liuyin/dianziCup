review_engine = Engine([redacted fragment][redacted fragment][redacted fragment][redacted fragment]_r01:***[redacted fragment][redacted fragment][redacted fragment][redacted fragment][redacted fragment]261015)

    def test_same_page_key_different_entries_must_not_silently_reuse_receipt(review_engine):
        now = datetime.now(UTC)
        source_id = seed_source(review_engine, now)
        callbacks = []
        with Session(review_engine) as session, session.begin():
            repository = SourceCursorRepository(session, ADMIN, source_id, clock=lambda: now)
            lease = repository.claim(stream_kind="live", lease_owner="review-replay", window_start=now - timedelta(days=1), window_end=now)
    
            def durable_recovery(session, entry):
                callbacks.append(entry["entry_id"])
                job_id = enqueue_job(session, None, "source_recovery", json.dumps({"source_id": source_id, "entry_id": entry["entry_id"]}).encode(), now)
                return PersistedPageEntry(failed_job_id=job_id)
    
            original = repository.commit_page(lease, page_key=make_page_key(lease, {}), input_cursor={}, output_cursor={"page": 1}, entries=({"entry_id": "original-entry"},), persist_entry=durable_recovery, is_last_page=True)
        rejected = False
        with Session(review_engine) as session, session.begin():
            repository = SourceCursorRepository(session, ADMIN, source_id, clock=lambda: now)
            try:
                repeated = repository.commit_page(lease, page_key=make_page_key(lease, {}), input_cursor={}, output_cursor={"page": 1}, entries=({"entry_id": "new-entry-not-saved"},), persist_entry=durable_recovery, is_last_page=True)
            except CursorCommitError:
                rejected = True
        observe("changed_replay_entries", {"source_id": source_id, "original_failed_job_ids": original.failed_job_ids, "changed_entry_rejected": rejected, "callbacks": callbacks, "receipt_reused": not rejected and repeated.reused})
>       assert rejected, "same cursor/count with different entry identities reused an unrelated receipt"
E       AssertionError: same cursor/count with different entry identities reused an unrelated receipt
E       assert False

