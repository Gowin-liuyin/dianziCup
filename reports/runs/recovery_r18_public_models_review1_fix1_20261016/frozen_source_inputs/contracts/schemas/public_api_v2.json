{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dianzi:public-api:v2",
  "title": "R00 公共合同 v2；实现/完整投影由R18完成",
  "schema_version": 2,
  "x-change-records": [
    "CR-R04",
    "CR-R09"
  ],
  "$defs": {
    "NormalizedIntel": {
      "type": "object",
      "properties": {
        "intel_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "advisory",
            "article",
            "paper",
            "repository_record",
            "standard",
            "policy"
          ]
        },
        "external_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 100
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "intel_id",
        "revision_id",
        "title",
        "kind",
        "external_ids",
        "citations",
        "data_mode"
      ],
      "additionalProperties": false
    },
    "Vulnerability": {
      "type": "object",
      "properties": {
        "intel_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "external_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        },
        "enrichments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Enrichment"
          },
          "maxItems": 9
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "maxItems": 100
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        }
      },
      "required": [
        "intel_id",
        "event_id",
        "title",
        "external_ids",
        "enrichments",
        "relations",
        "freshness"
      ],
      "additionalProperties": false
    },
    "Advisory": {
      "type": "object",
      "properties": {
        "intel_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 100
        }
      },
      "required": [
        "intel_id",
        "revision_id",
        "title",
        "source_uri",
        "published_at",
        "citations"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string",
          "format": "uuid"
        },
        "ecosystem": {
          "type": "string",
          "minLength": 1
        },
        "package_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "purl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ecosystem",
        "package_name",
        "version"
      ],
      "additionalProperties": false
    },
    "Enrichment": {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": [
            "cvss",
            "epss",
            "kev",
            "cwe",
            "atlas",
            "versions",
            "literature",
            "poc",
            "exposure"
          ]
        },
        "status": {
          "enum": [
            "available",
            "not_found",
            "not_applicable",
            "conflict",
            "blocked",
            "failed",
            "pending"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 100
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dimension",
        "status",
        "claim_ids",
        "citations",
        "freshness",
        "observed_at",
        "source_version",
        "error_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Relation": {
      "type": "object",
      "properties": {
        "relation_id": {
          "type": "string",
          "format": "uuid"
        },
        "relation_type": {
          "enum": [
            "same_event",
            "affects_component_version",
            "mapped_atlas",
            "related_paper",
            "remediated_by",
            "component_version_vulnerability"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "object_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_revision": {
          "type": "string",
          "format": "uuid"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 100
        },
        "rule_or_model_version": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "disputed",
            "unverified",
            "superseded",
            "withdrawn"
          ]
        }
      },
      "required": [
        "relation_id",
        "relation_type",
        "subject_id",
        "object_id",
        "source_revision",
        "citations",
        "rule_or_model_version",
        "reason",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Citation": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "evidence_id",
        "revision_id",
        "quote",
        "locator",
        "source_uri"
      ],
      "additionalProperties": false
    },
    "QAAnswer": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "completed"
        },
        "answer_id": {
          "type": "string",
          "format": "uuid"
        },
        "answer_text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "source_fact",
                  "rule_result",
                  "project_suggestion"
                ]
              },
              "support_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "maxItems": 100
              }
            },
            "required": [
              "text",
              "kind",
              "support_ids"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "source_fact",
                        "rule_result"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "support_ids": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 100
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 100
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_milliseconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "answer_id",
        "answer_text",
        "claims",
        "citations",
        "limitations",
        "freshness",
        "data_mode",
        "started_at",
        "completed_at",
        "latency_milliseconds"
      ],
      "additionalProperties": false
    },
    "TaskHandle": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "retry_wait",
            "waiting_approval",
            "partial"
          ]
        },
        "poll_uri": {
          "type": "string",
          "pattern": "^/api/v1/tasks/"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "task_id",
        "status",
        "poll_uri",
        "created_at"
      ],
      "additionalProperties": false
    },
    "AskResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/QAAnswer"
        },
        {
          "$ref": "#/$defs/TaskHandle"
        }
      ]
    },
    "AskRequest": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 20
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 20
        },
        "mode": {
          "enum": [
            "auto",
            "library",
            "investigate"
          ]
        },
        "known_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "question",
        "mode"
      ],
      "additionalProperties": false
    },
    "StackCheckRequest": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "maxItems": 200
        }
      },
      "required": [
        "components"
      ],
      "additionalProperties": false
    },
    "StackCheckResult": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "completed"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "$ref": "#/$defs/Component"
              },
              "status": {
                "enum": [
                  "supported_applicability",
                  "excluded_with_evidence",
                  "insufficient_evidence",
                  "conflicting_evidence"
                ]
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              },
              "assessment_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Citation"
                },
                "maxItems": 100
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale",
                  "unknown"
                ]
              }
            },
            "required": [
              "component",
              "status",
              "reason_code",
              "assessment_id",
              "citations",
              "freshness"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "reason_code": {
                      "enum": [
                        "no_match",
                        "unsupported",
                        "unsupported_rule",
                        "unsupported_ecosystem"
                      ]
                    }
                  },
                  "required": [
                    "reason_code"
                  ]
                },
                "then": {
                  "properties": {
                    "status": {
                      "const": "insufficient_evidence"
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        }
      },
      "required": [
        "kind",
        "results",
        "limitations"
      ],
      "additionalProperties": false
    },
    "StackUploadRequest": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "declared_component_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "format": {
          "enum": [
            "requirements_txt",
            "package_lock",
            "sbom_cyclonedx",
            "json_components",
            "csv_components"
          ]
        }
      },
      "required": [
        "upload_id",
        "size_bytes",
        "declared_component_count",
        "format"
      ],
      "additionalProperties": false
    }
  }
}
