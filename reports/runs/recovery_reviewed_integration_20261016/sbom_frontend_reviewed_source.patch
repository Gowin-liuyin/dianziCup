+    sbom.redactions = [{ source_field_locator: "/components/0/bom-ref", reason: "unsafe_uri_or_path", replacement_ref: alias }, { source_field_locator: "/dependencies/0/ref", reason: "unsafe_uri_or_path", replacement_ref: alias }];
