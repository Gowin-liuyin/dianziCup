diff --git a/backend/src/ai_intel/recommendations/contracts.py b/backend/src/ai_intel/recommendations/contracts.py
new file mode 100644
index 00000000..89d43c4f
--- /dev/null
+++ b/backend/src/ai_intel/recommendations/contracts.py
@@ -0,0 +1,213 @@
+"""Internal R15 candidates over server-authorized snapshots; these DTOs grant no access."""
+
+from __future__ import annotations
+
+from typing import Annotated, Literal
+
+from pydantic import Field, model_validator
+
+from ai_intel.api.knowledge_contracts import CitationProjection
+from ai_intel.assessment.conditions import ConditionContract, EvidenceReference, Label
+from ai_intel.assessment.persistence_contracts import AssessmentReceipt
+from ai_intel.domain.enums import AssessmentStatus, ClaimOrigin, ClaimStatus, FreshnessStatus
+from ai_intel.domain.values import UtcTimestamp
+
+POLICY_VERSION: Literal["r15-recommendation-policy-1"] = "r15-recommendation-policy-1"
+MAX_INPUT_EVENTS = 2000
+MAX_CANDIDATES = 200
+Priority = Annotated[int, Field(strict=True, ge=0, le=3)]
+CandidateKind = Literal[
+    "supported_risk", "prioritize_verification", "excluded_with_evidence", "intelligence_update"
+]
+ReportStopReason = Literal["disabled", "no_items_in_window", "complete", "item_budget"]
+
+
+class RecommendationSubscription(ConditionContract):
+    subscription_id: Label
+    tenant_id: Label
+    user_id: Label
+    enabled: bool = Field(strict=True)
+    product_keys: tuple[Label, ...] = Field(default=(), max_length=100)
+    asset_ids: tuple[Label, ...] = Field(default=(), max_length=100)
+    risk_topics: tuple[Label, ...] = Field(default=(), max_length=100)
+    maximum_priority_bucket: Priority = 3
+
+    @model_validator(mode="after")
+    def require_explicit_interests(self) -> RecommendationSubscription:
+        if not (self.product_keys or self.asset_ids or self.risk_topics):
+            raise ValueError("subscription_requires_explicit_interest")
+        for values in (self.product_keys, self.asset_ids, self.risk_topics):
+            if len(values) != len(set(values)):
+                raise ValueError("duplicate_subscription_interest")
+        return self
+
+
+class SelectorEvidence(ConditionContract):
+    """PG caller verified the exact selector/claim/citation support, beyond quote existence."""
+
+    selector_kind: Literal["product", "risk_topic", "consequence"]
+    selector_value: Label
+    claim_id: Label
+    claim_status: ClaimStatus
+    claim_origin: ClaimOrigin
+    support_kind: Literal["supports", "refutes", "context"]
+    validation_status: Literal["validated", "unverified"]
+    citations: tuple[CitationProjection, ...] = Field(min_length=1, max_length=8)
+
+    @model_validator(mode="after")
+    def bound_citation_size(self) -> SelectorEvidence:
+        if any(len(citation.quote) > 2000 for citation in self.citations):
+            raise ValueError("selector_quote_budget_exceeded")
+        return self
+
+
+class RecommendationEventInput(ConditionContract):
+    """As-of state and current state are distinct; observed_at is first material observation.
+
+    material_version must include changed assessments/rules/assets as well as event facts.
+    A historical caller must supply receipts valid at cutoff, never relabel current receipts.
+    """
+
+    event_id: Label
+    material_version: Label
+    observed_at: UtcTimestamp
+    source_changed_at: UtcTimestamp | None = None
+    valid_from: UtcTimestamp
+    valid_until: UtcTimestamp | None = None
+    status_at_cutoff: ClaimStatus
+    freshness_at_cutoff: FreshnessStatus
+    current_status: ClaimStatus
+    current_freshness: FreshnessStatus
+    current_state_checked_at: UtcTimestamp
+    selectors: tuple[SelectorEvidence, ...] = Field(default=(), max_length=32)
+    assessments: tuple[AssessmentReceipt, ...] = Field(default=(), max_length=20)
+
+    @model_validator(mode="after")
+    def require_valid_interval(self) -> RecommendationEventInput:
+        if self.valid_until is not None and self.valid_until <= self.valid_from:
+            raise ValueError("event_valid_interval_inverted")
+        if self.current_state_checked_at < self.observed_at:
+            raise ValueError("current_check_precedes_observation")
+        return self
+
+
+class RecommendationKey(ConditionContract):
+    subscription_id: Label
+    event_id: Label
+    material_version: Label
+
+
+class RecommendationReason(ConditionContract):
+    code: Literal["product_match", "risk_topic_match", "asset_assessment", "high_consequence"]
+    matched_key: Label
+    claim_id: Label | None = None
+    citations: tuple[CitationProjection, ...] = ()
+    assessment_id: Label | None = None
+
+    @model_validator(mode="after")
+    def require_reason_support(self) -> RecommendationReason:
+        if self.code == "asset_assessment":
+            if self.assessment_id is None or self.claim_id is not None or self.citations:
+                raise ValueError("asset_reason_requires_receipt_reference")
+        elif self.claim_id is None or not self.citations or self.assessment_id is not None:
+            raise ValueError("selector_reason_requires_claim_and_citations")
+        return self
+
+
+class AssessmentReference(ConditionContract):
+    """Original receipt result and evidence, retained without reevaluation."""
+
+    assessment_id: Label
+    asset_id: Label
+    asset_snapshot_id: Label
+    rule_id: Label
+    rule_version: int = Field(strict=True, ge=1)
+    status: AssessmentStatus
+    knowledge_epoch: int | None
+    scope_epoch_map: dict[str, int | None]
+    input_digest: str
+    evidence: tuple[EvidenceReference, ...]
+    missing_requirements: tuple[str, ...]
+    conflicts: tuple[str, ...]
+    limitations: tuple[str, ...]
+
+
+class RecommendationCandidate(ConditionContract):
+    key: RecommendationKey
+    tenant_id: Label
+    user_id: Label
+    policy_version: Literal["r15-recommendation-policy-1"] = POLICY_VERSION
+    kind: CandidateKind
+    priority_bucket: Priority
+    reasons: tuple[RecommendationReason, ...]
+    assessments: tuple[AssessmentReference, ...]
+    observed_at: UtcTimestamp
+    source_changed_at: UtcTimestamp | None
+    valid_from: UtcTimestamp
+    valid_until: UtcTimestamp | None
+    validity_as_of: UtcTimestamp
+    freshness_at_cutoff: FreshnessStatus
+    current_status: ClaimStatus
+    current_freshness: FreshnessStatus
+    current_state_checked_at: UtcTimestamp
+    limitations: tuple[str, ...]
+
+
+class RecommendationBatch(ConditionContract):
+    subscription: RecommendationSubscription
+    cutoff_at: UtcTimestamp
+    candidates: tuple[RecommendationCandidate, ...] = Field(max_length=MAX_CANDIDATES)
+    eligible_count: int = Field(strict=True, ge=0, le=MAX_INPUT_EVENTS)
+    partial: bool = Field(strict=True)
+    continuation_keys: tuple[RecommendationKey, ...] = Field(max_length=MAX_INPUT_EVENTS)
+    stop_reason: Literal["disabled", "no_supported_subscription_match", "complete", "item_budget"]
+
+    @model_validator(mode="after")
+    def require_explicit_completeness(self) -> RecommendationBatch:
+        if self.partial != bool(self.continuation_keys) or self.eligible_count != (
+            len(self.candidates) + len(self.continuation_keys)
+        ):
+            raise ValueError("batch_completeness_mismatch")
+        keys = tuple(candidate.key for candidate in self.candidates) + self.continuation_keys
+        identities = {(key.subscription_id, key.event_id, key.material_version) for key in keys}
+        if len(identities) != len(keys) or any(
+            key.subscription_id != self.subscription.subscription_id for key in keys
+        ):
+            raise ValueError("batch_key_binding_mismatch")
+        expected_reason = (
+            "disabled"
+            if not self.subscription.enabled
+            else (
+                "item_budget"
+                if self.partial
+                else ("complete" if self.candidates else "no_supported_subscription_match")
+            )
+        )
+        if self.stop_reason != expected_reason or (
+            not self.subscription.enabled and self.eligible_count
+        ):
+            raise ValueError("batch_stop_reason_mismatch")
+        return self
+
+
+class ReportCandidate(ConditionContract):
+    """An immutable report proposal, not a persisted report or a statement of current truth."""
+
+    policy_version: Literal["r15-recommendation-policy-1"] = POLICY_VERSION
+    subscription_id: Label
+    tenant_id: Label
+    user_id: Label
+    frequency: Literal["day", "week"]
+    window_start: UtcTimestamp
+    cutoff_at: UtcTimestamp
+    generated_at: UtcTimestamp
+    temporal_mode: Literal["as_of_cutoff"] = "as_of_cutoff"
+    window_basis: Literal["first_material_observed_at"] = "first_material_observed_at"
+    supported_risks: tuple[RecommendationCandidate, ...]
+    verification_items: tuple[RecommendationCandidate, ...]
+    excluded_items: tuple[RecommendationCandidate, ...]
+    intelligence_updates: tuple[RecommendationCandidate, ...]
+    partial: bool = Field(strict=True)
+    continuation_keys: tuple[RecommendationKey, ...]
+    stop_reason: ReportStopReason
+    limitations: tuple[str, ...]
diff --git a/backend/src/ai_intel/recommendations/policy.py b/backend/src/ai_intel/recommendations/policy.py
new file mode 100644
index 00000000..fb08d03f
--- /dev/null
+++ b/backend/src/ai_intel/recommendations/policy.py
@@ -0,0 +1,345 @@
+"""Deterministic recommendations; storage, authentication and PG checks belong to callers."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from uuid import UUID
+
+from pydantic import TypeAdapter
+
+from ai_intel.api.knowledge_contracts import CitationProjection
+from ai_intel.assessment.conditions import EvidenceReference
+from ai_intel.assessment.persistence_contracts import AssessmentReceipt
+from ai_intel.domain.enums import AssessmentStatus, ClaimOrigin, ClaimStatus, FreshnessStatus
+from ai_intel.domain.values import UtcTimestamp
+from ai_intel.recommendations.contracts import (
+    MAX_CANDIDATES,
+    MAX_INPUT_EVENTS,
+    AssessmentReference,
+    CandidateKind,
+    RecommendationBatch,
+    RecommendationCandidate,
+    RecommendationEventInput,
+    RecommendationKey,
+    RecommendationReason,
+    RecommendationSubscription,
+    SelectorEvidence,
+)
+
+
+def require_item_budget(value: int) -> None:
+    if type(value) is not int or not 1 <= value <= MAX_CANDIDATES:
+        raise ValueError("item_budget_out_of_bounds")
+
+
+def _supported(selector: SelectorEvidence) -> bool:
+    return (
+        selector.claim_status == ClaimStatus.SUPPORTED
+        and selector.claim_origin != ClaimOrigin.MODEL_HYPOTHESIS
+        and selector.support_kind == "supports"
+        and selector.validation_status == "validated"
+    )
+
+
+def _assessment_reference(receipt: AssessmentReceipt) -> AssessmentReference:
+    snapshot = receipt.prepared.asset_snapshot
+    rule = receipt.prepared.inputs.rule
+    result = receipt.rule_result
+    if (
+        (receipt.tenant_id, receipt.asset_id, receipt.asset_snapshot_id)
+        != (snapshot.tenant_id, snapshot.asset_id, snapshot.snapshot_id)
+        or (receipt.event_id, receipt.rule_id, receipt.rule_version)
+        != (rule.event_id, rule.rule_id, rule.version)
+        or receipt.prepared.scope_watch.tenant_id != receipt.tenant_id
+        or not receipt.prepared.asset_active
+        or receipt.prepared.asset_current_snapshot_id != receipt.asset_snapshot_id
+        or (result is None and receipt.status != AssessmentStatus.INSUFFICIENT_EVIDENCE)
+        or (
+            result is not None
+            and (
+                result.status != receipt.status
+                or (result.rule_id, result.rule_version, result.asset_snapshot_id)
+                != (receipt.rule_id, receipt.rule_version, receipt.asset_snapshot_id)
+            )
+        )
+    ):
+        raise ValueError("assessment_receipt_binding_mismatch")
+    nodes_by_evidence: dict[str, set[str]] = {}
+    pending_nodes = [result.evaluation_tree] if result is not None else []
+    while pending_nodes:
+        node = pending_nodes.pop()
+        for evidence_id in node.evidence_ids:
+            nodes_by_evidence.setdefault(evidence_id, set()).add(node.node_id)
+        pending_nodes.extend(node.child_results)
+    evidence_by_id: dict[str, EvidenceReference] = {}
+    for support in receipt.prepared.inputs.supports:
+        span = support.evidence
+        if span.evidence_id not in nodes_by_evidence:
+            continue
+        if (
+            support.binding.evidence_id != span.evidence_id
+            or support.binding.node_id not in nodes_by_evidence[span.evidence_id]
+            or span.validation_status != "validated"
+            or support.semantic_status not in {"supports", "refutes"}
+            or span.support_kind != support.semantic_status
+        ):
+            raise ValueError("assessment_evidence_binding_mismatch")
+        previous = evidence_by_id.get(span.evidence_id)
+        if previous is not None and previous != span:
+            raise ValueError("assessment_evidence_identity_mismatch")
+        evidence_by_id[span.evidence_id] = span
+    if nodes_by_evidence.keys() != evidence_by_id.keys():
+        raise ValueError("assessment_evidence_binding_mismatch")
+    evidence = tuple(evidence_by_id[key] for key in sorted(evidence_by_id))
+    if (
+        receipt.status
+        in {
+            AssessmentStatus.SUPPORTED_APPLICABILITY,
+            AssessmentStatus.EXCLUDED_WITH_EVIDENCE,
+        }
+        and not evidence
+    ):
+        raise ValueError("definitive_assessment_requires_evidence")
+    if any(
+        span.scope.visibility == "tenant" and span.scope.tenant_id != receipt.tenant_id
+        for span in evidence
+    ):
+        raise ValueError("assessment_evidence_tenant_mismatch")
+    return AssessmentReference(
+        assessment_id=receipt.assessment_id,
+        asset_id=receipt.asset_id,
+        asset_snapshot_id=receipt.asset_snapshot_id,
+        rule_id=receipt.rule_id,
+        rule_version=receipt.rule_version,
+        status=receipt.status,
+        knowledge_epoch=receipt.knowledge_epoch,
+        scope_epoch_map=dict(receipt.scope_epoch_map),
+        input_digest=receipt.input_digest,
+        evidence=evidence,
+        missing_requirements=receipt.missing_requirements,
+        conflicts=receipt.conflicts,
+        limitations=receipt.limitations,
+    )
+
+
+def candidate_order(candidate: RecommendationCandidate) -> tuple[int, int, float, str, str]:
+    """High-consequence unresolved conditions precede supported risks in the same bucket."""
+    kind_order = {
+        "prioritize_verification": 0,
+        "supported_risk": 1,
+        "intelligence_update": 2,
+        "excluded_with_evidence": 3,
+    }
+    return (
+        candidate.priority_bucket,
+        kind_order[candidate.kind],
+        -candidate.observed_at.timestamp(),
+        candidate.key.event_id,
+        candidate.key.material_version,
+    )
+
+
+def _candidate(
+    subscription: RecommendationSubscription, event: RecommendationEventInput, cutoff: datetime
+) -> RecommendationCandidate | None:
+    if event.current_state_checked_at < cutoff:
+        raise ValueError("current_state_check_precedes_cutoff")
+    if event.current_state_checked_at == cutoff and (
+        event.status_at_cutoff != event.current_status
+        or event.freshness_at_cutoff != event.current_freshness
+    ):
+        raise ValueError("as_of_state_conflicts_with_current_state")
+    if (
+        event.observed_at > cutoff
+        or event.valid_from > cutoff
+        or (event.valid_until is not None and event.valid_until <= cutoff)
+        or event.status_at_cutoff in {ClaimStatus.WITHDRAWN, ClaimStatus.SUPERSEDED}
+        or event.freshness_at_cutoff != FreshnessStatus.CURRENT
+    ):
+        return None
+    reasons: list[RecommendationReason] = []
+    high_consequence = False
+    for selector in event.selectors:
+        if not _supported(selector):
+            continue
+        if selector.selector_kind == "consequence" and selector.selector_value == "high":
+            high_consequence = True
+        elif (
+            selector.selector_kind == "product"
+            and selector.selector_value in subscription.product_keys
+        ) or (
+            selector.selector_kind == "risk_topic"
+            and selector.selector_value in subscription.risk_topics
+        ):
+            reasons.append(
+                RecommendationReason(
+                    code="product_match"
+                    if selector.selector_kind == "product"
+                    else "risk_topic_match",
+                    matched_key=selector.selector_value,
+                    claim_id=selector.claim_id,
+                    citations=selector.citations,
+                )
+            )
+    assessments: list[AssessmentReference] = []
+    for receipt in event.assessments:
+        if receipt.tenant_id != subscription.tenant_id or receipt.event_id != event.event_id:
+            raise ValueError("assessment_scope_mismatch")
+        if receipt.asset_id not in subscription.asset_ids:
+            continue
+        if receipt.freshness != FreshnessStatus.CURRENT or receipt.created_at > cutoff:
+            continue
+        reference = _assessment_reference(receipt)
+        assessments.append(reference)
+        reasons.append(
+            RecommendationReason(
+                code="asset_assessment",
+                matched_key=receipt.asset_id,
+                assessment_id=receipt.assessment_id,
+            )
+        )
+    if not reasons:
+        return None
+    if high_consequence:
+        for selector in event.selectors:
+            if _supported(selector) and (selector.selector_kind, selector.selector_value) == (
+                "consequence",
+                "high",
+            ):
+                reasons.append(
+                    RecommendationReason(
+                        code="high_consequence",
+                        matched_key="high",
+                        claim_id=selector.claim_id,
+                        citations=selector.citations,
+                    )
+                )
+    states = {reference.status for reference in assessments}
+    unresolved = (
+        bool(
+            states & {AssessmentStatus.INSUFFICIENT_EVIDENCE, AssessmentStatus.CONFLICTING_EVIDENCE}
+        )
+        or event.status_at_cutoff != ClaimStatus.SUPPORTED
+    )
+    kind: CandidateKind
+    if unresolved:
+        kind = "prioritize_verification"
+        priority = 0 if high_consequence else 2
+    elif AssessmentStatus.SUPPORTED_APPLICABILITY in states:
+        kind = "supported_risk"
+        priority = 0 if high_consequence else 1
+    elif states and states == {AssessmentStatus.EXCLUDED_WITH_EVIDENCE}:
+        kind = "excluded_with_evidence"
+        priority = 3
+    else:
+        kind = "intelligence_update"
+        priority = 0 if high_consequence else 3
+    if priority > subscription.maximum_priority_bucket:
+        return None
+    return RecommendationCandidate(
+        key=RecommendationKey(
+            subscription_id=subscription.subscription_id,
+            event_id=event.event_id,
+            material_version=event.material_version,
+        ),
+        tenant_id=subscription.tenant_id,
+        user_id=subscription.user_id,
+        kind=kind,
+        priority_bucket=priority,
+        reasons=tuple(
+            sorted(
+                reasons,
+                key=lambda item: (
+                    item.code,
+                    item.matched_key,
+                    item.claim_id or item.assessment_id or "",
+                ),
+            )
+        ),
+        assessments=tuple(sorted(assessments, key=lambda item: item.assessment_id)),
+        observed_at=event.observed_at,
+        source_changed_at=event.source_changed_at,
+        valid_from=event.valid_from,
+        valid_until=event.valid_until,
+        validity_as_of=cutoff,
+        freshness_at_cutoff=event.freshness_at_cutoff,
+        current_status=event.current_status,
+        current_freshness=event.current_freshness,
+        current_state_checked_at=event.current_state_checked_at,
+        limitations=("project_priority_rule_not_exploit_confirmation",)
+        + (("unresolved_evidence_requires_verification",) if unresolved else ()),
+    )
+
+
+def generate_recommendation_candidates(
+    subscription: RecommendationSubscription,
+    events: tuple[RecommendationEventInput, ...],
+    *,
+    cutoff_at: datetime,
+    existing_keys: tuple[RecommendationKey, ...] = (),
+    max_candidates: int = MAX_CANDIDATES,
+) -> RecommendationBatch:
+    """Caller must enforce PG authorization and as-of validity before calling and before commit.
+
+    This function does not persist deduplication or check subscription revocation races.
+    """
+    require_item_budget(max_candidates)
+    cutoff = TypeAdapter(UtcTimestamp).validate_python(cutoff_at)
+    subscription = RecommendationSubscription.model_validate(subscription.model_dump(mode="python"))
+    if len(events) > MAX_INPUT_EVENTS or len(existing_keys) > MAX_INPUT_EVENTS:
+        raise ValueError("input_event_budget_exceeded")
+    if not subscription.enabled:
+        return RecommendationBatch(
+            subscription=subscription,
+            cutoff_at=cutoff,
+            candidates=(),
+            eligible_count=0,
+            partial=False,
+            continuation_keys=(),
+            stop_reason="disabled",
+        )
+    seen = {(key.subscription_id, key.event_id, key.material_version) for key in existing_keys}
+    versions: dict[tuple[str, str], RecommendationEventInput] = {}
+    citations_by_id: dict[UUID, CitationProjection] = {}
+    active_events: set[str] = set()
+    candidates: list[RecommendationCandidate] = []
+    for item in events:
+        event = RecommendationEventInput.model_validate(item.model_dump(mode="python"))
+        for selector in event.selectors:
+            for citation in selector.citations:
+                previous_citation = citations_by_id.get(citation.evidence_id)
+                if previous_citation is not None and previous_citation != citation:
+                    raise ValueError("selector_evidence_identity_mismatch")
+                citations_by_id[citation.evidence_id] = citation
+        version_key = (event.event_id, event.material_version)
+        previous = versions.get(version_key)
+        if previous is not None:
+            if previous != event:
+                raise ValueError("material_version_collision")
+            continue
+        versions[version_key] = event
+        candidate = _candidate(subscription, event, cutoff)
+        if candidate is not None:
+            if event.event_id in active_events:
+                raise ValueError("ambiguous_active_material_versions")
+            active_events.add(event.event_id)
+            if (
+                candidate.key.subscription_id,
+                candidate.key.event_id,
+                candidate.key.material_version,
+            ) not in seen:
+                candidates.append(candidate)
+    candidates.sort(key=candidate_order)
+    selected = tuple(candidates[:max_candidates])
+    continuation = tuple(candidate.key for candidate in candidates[max_candidates:])
+    return RecommendationBatch(
+        subscription=subscription,
+        cutoff_at=cutoff,
+        candidates=selected,
+        eligible_count=len(candidates),
+        partial=bool(continuation),
+        continuation_keys=continuation,
+        stop_reason="item_budget"
+        if continuation
+        else ("complete" if candidates else "no_supported_subscription_match"),
+    )
diff --git a/backend/src/ai_intel/recommendations/report_builder.py b/backend/src/ai_intel/recommendations/report_builder.py
new file mode 100644
index 00000000..72300ae4
--- /dev/null
+++ b/backend/src/ai_intel/recommendations/report_builder.py
@@ -0,0 +1,92 @@
+"""Daily/weekly proposals preserve the selected cutoff and first observation window."""
+
+from datetime import datetime, timedelta
+from typing import Literal
+
+from pydantic import TypeAdapter
+
+from ai_intel.domain.enums import ClaimStatus, FreshnessStatus
+from ai_intel.domain.values import UtcTimestamp
+from ai_intel.recommendations.contracts import (
+    MAX_CANDIDATES,
+    RecommendationBatch,
+    ReportCandidate,
+    ReportStopReason,
+)
+from ai_intel.recommendations.policy import candidate_order, require_item_budget
+
+
+def build_report_candidate(
+    batch: RecommendationBatch,
+    *,
+    frequency: Literal["day", "week"],
+    cutoff_at: datetime,
+    generated_at: datetime,
+    max_items: int = MAX_CANDIDATES,
+) -> ReportCandidate:
+    """Window is (cutoff - 1/7 days, cutoff]; older source dates never hide late observations.
+
+    Historical reports retain validity_as_of and separate current_status metadata.
+    The caller must freeze/select historical PG facts; no present state is backdated here.
+    """
+    require_item_budget(max_items)
+    cutoff = TypeAdapter(UtcTimestamp).validate_python(cutoff_at)
+    generated = TypeAdapter(UtcTimestamp).validate_python(generated_at)
+    batch = RecommendationBatch.model_validate(batch.model_dump(mode="python"))
+    if frequency not in {"day", "week"}:
+        raise ValueError("unsupported_report_frequency")
+    if cutoff != batch.cutoff_at or generated < cutoff:
+        raise ValueError("report_cutoff_mismatch")
+    window_start = cutoff - timedelta(days=1 if frequency == "day" else 7)
+    items = []
+    for candidate in batch.candidates:
+        if (
+            candidate.tenant_id != batch.subscription.tenant_id
+            or candidate.user_id != batch.subscription.user_id
+            or candidate.key.subscription_id != batch.subscription.subscription_id
+            or candidate.validity_as_of != cutoff
+            or candidate.observed_at > cutoff
+            or candidate.valid_from > cutoff
+            or (candidate.valid_until is not None and candidate.valid_until <= cutoff)
+            or candidate.freshness_at_cutoff != FreshnessStatus.CURRENT
+            or candidate.current_state_checked_at > generated
+            or (
+                candidate.current_state_checked_at == cutoff
+                and candidate.current_status in {ClaimStatus.WITHDRAWN, ClaimStatus.SUPERSEDED}
+            )
+        ):
+            raise ValueError("report_candidate_scope_mismatch")
+        if window_start < candidate.observed_at <= cutoff:
+            items.append(candidate)
+    items.sort(key=candidate_order)
+    selected = items[:max_items] if batch.subscription.enabled else []
+    continuation = tuple(item.key for item in items[max_items:]) + batch.continuation_keys
+    partial = bool(continuation) or batch.partial
+    stop_reason: ReportStopReason = (
+        "disabled"
+        if not batch.subscription.enabled
+        else ("item_budget" if partial else ("complete" if selected else "no_items_in_window"))
+    )
+    return ReportCandidate(
+        subscription_id=batch.subscription.subscription_id,
+        tenant_id=batch.subscription.tenant_id,
+        user_id=batch.subscription.user_id,
+        frequency=frequency,
+        window_start=window_start,
+        cutoff_at=cutoff,
+        generated_at=generated,
+        supported_risks=tuple(item for item in selected if item.kind == "supported_risk"),
+        verification_items=tuple(
+            item for item in selected if item.kind == "prioritize_verification"
+        ),
+        excluded_items=tuple(item for item in selected if item.kind == "excluded_with_evidence"),
+        intelligence_updates=tuple(item for item in selected if item.kind == "intelligence_update"),
+        partial=partial,
+        continuation_keys=continuation,
+        stop_reason=stop_reason,
+        limitations=(
+            "candidate_only_requires_pg_authorization_and_final_validity_check",
+            "window_uses_first_material_observation_not_source_publication",
+            "historical_validity_is_not_current_validity",
+        ),
+    )
