+    )
+    assert historical.temporal_mode == "as_of_cutoff"
+    item = historical.intelligence_updates[0]
+    assert item.freshness_at_cutoff == FreshnessStatus.CURRENT
+    assert item.current_status == ClaimStatus.WITHDRAWN
