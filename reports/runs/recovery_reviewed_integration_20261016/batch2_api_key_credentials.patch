+                with pytest.raises(InvalidApiKeyError):
+                    lock_authenticated_principal(connection, credential, NOW)
+            else:
+                assert lock_authenticated_principal(
+                    connection, credential, NOW
+                ).permissions == frozenset({"read:public"})
+    finally:
+        if process.is_alive():
+            process.terminate()
+            process.join(5)
+        parent.close()
