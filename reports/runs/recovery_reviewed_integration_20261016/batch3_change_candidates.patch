+        scope_epoch_map={"public": 2, "tenant:fixture-tenant": None},
+        query_fingerprint="a" * 64,
+        partition_fingerprint="b" * 32,
+        limit=20,
+        after_asset_id="fixture-asset",
+        after_kind="asset",
+        after_reference_id="fixture-asset",
+    )
