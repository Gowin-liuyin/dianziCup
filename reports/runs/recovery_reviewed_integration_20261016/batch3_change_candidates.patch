+    prior = assessment(pg_engine, seeded, imported)
+    changed = asset(pg_engine, seeded, "1.5.0", asset_id=imported.asset_id)
+    change = latest_change(
+        pg_engine, "tenant:" + seeded["tenant"], change_type="asset_snapshot_changed"
