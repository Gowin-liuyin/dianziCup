+
+
+@pytest.mark.parametrize(
+    "reason", ["no_match", "unsupported", "unsupported_rule", "unsupported_ecosystem"]
+)
+def test_no_match_or_unsupported_cannot_be_exclusion(reason: str) -> None:
+    result = {
+        "kind": "completed",
+        "results": [
