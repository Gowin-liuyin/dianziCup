+"""Observable public v2 semantics and fixed source-contract comparisons."""
+
+from __future__ import annotations
+
+import json
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+from ai_intel_client.models import (
+    ASK_RESULT_ADAPTER,
+    Advisory,
+    AskRequest,
