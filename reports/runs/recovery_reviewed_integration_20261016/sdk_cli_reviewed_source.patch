index 00000000..2395d032
--- /dev/null
+++ b/sdk/python/ai_intel_client/client.py
@@ -0,0 +1,335 @@
+"""Bounded fixed-path HTTP operations against the project's shared backend."""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+import re
+import secrets
+from collections.abc import Mapping
+from typing import TypeVar
+from urllib.parse import urlsplit
+
+import httpx
+from pydantic import (
+    BaseModel,
+    ConfigDict,
+    Field,
+    JsonValue,
+    SecretStr,
+    TypeAdapter,
+    ValidationError,
+)
+
+from ai_intel_client.models import (
+    ASK_RESULT_ADAPTER,
+    AskRequest,
+    AskResult,
+    QAAnswer,
+    StackCheckRequest,
+    StackCheckResult,
+    TaskHandle,
+)
+
+MAX_RESPONSE_BYTES = 1048576
+MAX_SYNCHRONOUS_REQUEST_BYTES = 1048576
+ResultType = TypeVar("ResultType")
+
+
+class ClientConfigurationError(ValueError):
+    """Missing or unsafe client configuration; no configuration value is echoed."""
+
+
+class ClientInputError(ValueError):
+    """Invalid local input before a backend request was sent."""
+
+
+class ResponseContractError(ValueError):
+    """The backend result did not satisfy the frozen response boundary."""
+
+
+class ApiErrorDetails(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, hide_input_in_errors=True)
+    code: str = Field(pattern=r"^[a-z][a-z0-9_]{0,99}$")
+    message: str
+    retryable: bool
+    details: dict[str, JsonValue]
+
+
+class ApiProblem(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, hide_input_in_errors=True)
+    type: str
+    title: str
+    status: int = Field(ge=400, le=599)
+    detail: str
+    instance: str
+    error: ApiErrorDetails
+    trace_id: str = Field(pattern=r"^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")
+
+
+class DianziApiError(RuntimeError):
+    """Public fixed error metadata, without server text or response bodies in logs."""
+
+    def __init__(self, status: int, code: str, trace_id: str | None, retryable: bool) -> None:
+        super().__init__(f"backend request failed: HTTP {status}")
+        self.status = status
+        self.code = code
+        self.trace_id = trace_id
+        self.retryable = retryable
+
+
+class DianziTransportError(RuntimeError):
+    """A POST may have executed; callers can query or reuse its operation key."""
+
+    def __init__(self, idempotency_key: str, may_have_executed: bool) -> None:
+        super().__init__("backend request could not be completed")
+        self.idempotency_key = idempotency_key
+        self.may_have_executed = may_have_executed
+
+
+def _unique_json_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _reject_nonfinite_json(_: str) -> object:
+    raise ValueError("nonfinite JSON number")
+
+
+def _parse_finite_float(value: str) -> float:
+    parsed = float(value)
+    if not math.isfinite(parsed):
+        raise ValueError("nonfinite JSON number")
+    return parsed
+
+
+def validate_json_bytes(raw: bytes) -> None:
+    """Reject duplicate fields and invalid JSON before typed validation chooses values."""
+    try:
+        json.loads(
+            raw,
+            object_pairs_hook=_unique_json_object,
+            parse_constant=_reject_nonfinite_json,
+            parse_float=_parse_finite_float,
+        )
+    except (ValueError, UnicodeError, RecursionError):
+        raise ResponseContractError("response JSON is invalid") from None
+
+
+def _validate_base_url(value: str) -> str:
+    try:
+        parsed = urlsplit(value)
+        port = parsed.port
+        http_allowed = parsed.scheme == "http" and parsed.hostname in {
+            "127.0.0.1",
+            "localhost",
+            "::1",
+        }
+        if (
+            not value
+            or value != value.strip()
+            or any(ord(character) <= 32 for character in value)
+            or parsed.scheme not in {"http", "https"}
+            or (parsed.scheme == "http" and not http_allowed)
+            or not parsed.hostname
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+            or (port is not None and port == 0)
+        ):
+            raise ValueError("invalid base URL")
+        httpx.URL(value)
+    except (ValueError, httpx.InvalidURL):
+        raise ClientConfigurationError("backend base URL is invalid") from None
+    return value.rstrip("/")
+
+
+def _validate_operation_key(value: str) -> str:
+    if re.fullmatch(r"[\x21-\x7e]{1,200}", value) is None:
+        raise ClientInputError("operation key is invalid")
+    return value
+
+
+def _remove_cookie_authentication(request: httpx.Request) -> None:
+    """A server's Set-Cookie must not turn subsequent Bearer calls into cookie calls."""
+    request.headers.pop("cookie", None)
+
+
+class DianziClient:
+    """No retries, arbitrary URLs, database credentials or duplicated business decisions."""
+
+    def __init__(
+        self,
+        base_url: str,
+        api_key: SecretStr,
+        *,
+        timeout_seconds: float = 10,
+        question_timeout_seconds: float = 100,
+        transport: httpx.BaseTransport | None = None,
+    ) -> None:
+        origin = _validate_base_url(base_url)
+        if not isinstance(api_key, SecretStr):
+            raise ClientConfigurationError("API key must use SecretStr")
+        credential = api_key.get_secret_value()
+        if (
+            not 32 <= len(credential) <= 4096
+            or re.fullmatch(r"[A-Za-z0-9._~+/-]+=*", credential) is None
+        ):
+            raise ClientConfigurationError("API key is invalid")
+        if (
+            type(timeout_seconds) not in {int, float}
+            or type(question_timeout_seconds) not in {int, float}
+            or not 0 < timeout_seconds <= 60
+            or not 0 < question_timeout_seconds <= 120
+        ):
+            raise ClientConfigurationError("client timeout is outside the allowed bounds")
+        self._question_timeout_seconds = question_timeout_seconds
+        self._timeout_seconds = timeout_seconds
+        self._http = httpx.Client(
+            base_url=origin,
+            headers={
+                "Authorization": "Bearer " + credential,
+                "Accept": "application/json",
+                "Accept-Encoding": "identity",
+            },
+            timeout=timeout_seconds,
+            follow_redirects=False,
+            trust_env=False,
+            transport=transport,
+            event_hooks={"request": [_remove_cookie_authentication]},
+        )
+
+    @classmethod
+    def from_environment(cls, environment: Mapping[str, str] | None = None) -> DianziClient:
+        configured = os.environ if environment is None else environment
+        base_url = configured.get("DIANZI_API_BASE_URL")
+        key = configured.get("DIANZI_API_KEY")
+        if not base_url or not key:
+            raise ClientConfigurationError("backend base URL and API key must be configured")
+        return cls(base_url, SecretStr(key))
+
+    def close(self) -> None:
+        self._http.close()
+
+    def __enter__(self) -> DianziClient:
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+    def _post(
+        self,
+        path: str,
+        body: str,
+        operation_key: str,
+        adapter: TypeAdapter[ResultType],
+        timeout_seconds: float,
+    ) -> tuple[int, ResultType]:
+        encoded = body.encode("utf-8")
+        if len(encoded) > MAX_SYNCHRONOUS_REQUEST_BYTES:
+            raise ClientInputError("synchronous request exceeds the client size boundary")
+        try:
+            with self._http.stream(
+                "POST",
+                path,
+                content=encoded,
+                headers={"Content-Type": "application/json", "Idempotency-Key": operation_key},
+                timeout=timeout_seconds,
+            ) as response:
+                if response.headers.get("content-encoding", "identity").lower() != "identity":
+                    raise ResponseContractError(
+                        "compressed response is outside the client boundary"
+                    )
+                raw = bytearray()
+                for chunk in response.iter_bytes():
+                    if len(raw) + len(chunk) > MAX_RESPONSE_BYTES:
+                        raise ResponseContractError("response exceeds the allowed size")
+                    raw.extend(chunk)
+                content = bytes(raw)
+                if response.status_code not in {200, 202}:
+                    problem = None
+                    if (
+                        response.headers.get("content-type", "").split(";", 1)[0].lower()
+                        == "application/problem+json"
+                    ):
+                        try:
+                            validate_json_bytes(content)
+                            problem = ApiProblem.model_validate_json(content)
+                        except (ResponseContractError, ValidationError):
+                            problem = None
+                    if problem is None or problem.status != response.status_code:
+                        raise DianziApiError(response.status_code, "http_error", None, False)
+                    raise DianziApiError(
+                        problem.status,
+                        problem.error.code,
+                        problem.trace_id,
+                        problem.error.retryable,
+                    )
+                if (
+                    response.headers.get("content-type", "").split(";", 1)[0].lower()
+                    != "application/json"
+                ):
+                    raise ResponseContractError("response content type is invalid")
+                validate_json_bytes(content)
+                try:
+                    result = adapter.validate_json(content)
+                except ValidationError:
+                    raise ResponseContractError(
+                        "response does not match the public contract"
+                    ) from None
+                return response.status_code, result
+        except httpx.HTTPError:
+            raise DianziTransportError(operation_key, True) from None
+
+    def ask(self, request: AskRequest, *, idempotency_key: str | None = None) -> AskResult:
+        if not isinstance(request, AskRequest):
+            raise ClientInputError("question request is invalid")
+        try:
+            validated = AskRequest.model_validate_json(request.wire_json())
+        except (ValidationError, UnicodeError, ValueError):
+            raise ClientInputError("question request is invalid") from None
+        key = _validate_operation_key(
+            secrets.token_urlsafe(32) if idempotency_key is None else idempotency_key
+        )
+        status, result = self._post(
+            "/api/v1/ask",
+            validated.wire_json(),
+            key,
+            ASK_RESULT_ADAPTER,
+            self._question_timeout_seconds,
+        )
+        if (isinstance(result, QAAnswer) and status != 200) or (
+            isinstance(result, TaskHandle) and status != 202
+        ):
+            raise ResponseContractError("answer kind does not match HTTP status")
+        return result
+
+    def check_stack(
+        self, request: StackCheckRequest, *, idempotency_key: str | None = None
+    ) -> StackCheckResult:
+        if not isinstance(request, StackCheckRequest):
+            raise ClientInputError("stack request is invalid")
+        try:
+            validated = StackCheckRequest.model_validate_json(request.wire_json())
+        except (ValidationError, UnicodeError, ValueError):
+            raise ClientInputError("stack request is invalid") from None
+        key = _validate_operation_key(
+            secrets.token_urlsafe(32) if idempotency_key is None else idempotency_key
+        )
+        status, result = self._post(
+            "/api/v1/stack/check",
+            validated.wire_json(),
+            key,
+            TypeAdapter(StackCheckResult),
+            self._timeout_seconds,
+        )
+        if status != 200:
+            raise ResponseContractError("synchronous stack result requires HTTP 200")
+        return result
diff --git a/sdk/python/ai_intel_client/models.py b/sdk/python/ai_intel_client/models.py
new file mode 100644
index 00000000..4ea0880a
--- /dev/null
+++ b/sdk/python/ai_intel_client/models.py
@@ -0,0 +1,310 @@
+"""Typed projections of the approved public API v2; no backend or database imports."""
+
+from __future__ import annotations
+
+import json
+import re
+from typing import Annotated, Literal
+from uuid import UUID
+
+from pydantic import (
+    AfterValidator,
+    AnyUrl,
+    AwareDatetime,
+    BaseModel,
+    BeforeValidator,
+    ConfigDict,
+    Field,
+    TypeAdapter,
+    ValidationInfo,
+    model_validator,
+)
+
+Freshness = Literal["current", "stale", "unknown"]
+DataMode = Literal["live", "fixture"]
+ClaimStatus = Literal["supported", "disputed", "unverified", "superseded", "withdrawn"]
+DimensionName = Literal[
+    "cvss", "epss", "kev", "cwe", "atlas", "versions", "literature", "poc", "exposure"
+]
+DimensionStatus = Literal[
+    "available", "not_found", "not_applicable", "conflict", "blocked", "failed", "pending"
+]
+AssessmentStatus = Literal[
+    "supported_applicability",
+    "excluded_with_evidence",
+    "insufficient_evidence",
+    "conflicting_evidence",
+]
+Text = Annotated[str, Field(min_length=1)]
+URI_ADAPTER = TypeAdapter(AnyUrl)
+DATETIME_JSON_ADAPTER = TypeAdapter(AwareDatetime, config=ConfigDict(strict=True))
+
+
+def _validate_absolute_uri(value: str) -> str:
+    if (
+        re.fullmatch(r"[A-Za-z][A-Za-z0-9+.-]*:[A-Za-z0-9\-._~:/?#\[\]@!$&'()*+,;=%]*", value)
+        is None
+        or re.search(r"%(?![0-9a-fA-F]{2})", value) is not None
+    ):
+        raise ValueError("invalid absolute URI")
+    URI_ADAPTER.validate_python(value)
+    return value
+
+
+AbsoluteUri = Annotated[
+    str,
+    Field(json_schema_extra={"format": "uri"}),
+    AfterValidator(_validate_absolute_uri),
+]
+
+
+def _validate_uuid_spelling(value: object) -> object:
+    """Check wire spelling before Pydantic can normalize broader UUID forms."""
+    if (
+        isinstance(value, str)
+        and re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", value) is None
+    ):
+        raise ValueError("UUID requires its hyphenated public spelling")
+    return value
+
+
+def _validate_datetime_spelling(value: object, info: ValidationInfo) -> object:
+    """Limit JSON text to the frozen date-time format; the core checks calendar validity."""
+    if (
+        isinstance(value, str)
+        and re.fullmatch(
+            r"[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]"
+            r"(?:\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])",
+            value,
+        )
+        is None
+    ):
+        raise ValueError("timestamp requires the public RFC3339 spelling")
+    if info.mode == "json" and isinstance(value, str):
+        return DATETIME_JSON_ADAPTER.validate_json(json.dumps(value))
+    return value
+
+
+PublicUuid = Annotated[UUID, BeforeValidator(_validate_uuid_spelling)]
+PublicDateTime = Annotated[AwareDatetime, BeforeValidator(_validate_datetime_spelling)]
+
+
+class PublicRecord(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, frozen=True, hide_input_in_errors=True)
+
+    def wire_json(self, *, ensure_ascii: bool = False) -> str:
+        """Omitted optional fields remain omitted rather than becoming invalid nulls."""
+        return self.model_dump_json(exclude_unset=True, ensure_ascii=ensure_ascii, warnings="error")
+
+
+class Citation(PublicRecord):
+    evidence_id: PublicUuid
+    revision_id: PublicUuid
+    quote: Text
+    locator: Text
+    source_uri: AbsoluteUri
+
+
+class Component(PublicRecord):
+    component_id: PublicUuid | None = None
+    ecosystem: Text
+    package_name: Text
+    version: str | None
+    purl: str | None = None
+
+    @model_validator(mode="after")
+    def require_nonnull_component_id_when_present(self) -> Component:
+        if "component_id" in self.model_fields_set and self.component_id is None:
+            raise ValueError("component ID cannot be null when present")
+        return self
+
+
+class Enrichment(PublicRecord):
+    dimension: DimensionName
+    status: DimensionStatus
+    claim_ids: tuple[PublicUuid, ...] = Field(max_length=100)
+    citations: tuple[Citation, ...] = Field(max_length=100)
+    freshness: Freshness
+    observed_at: PublicDateTime | None
+    source_version: str | None
+    error_code: str | None
+
+    @model_validator(mode="after")
+    def require_available_evidence(self) -> Enrichment:
+        if self.status == "available" and not self.citations:
+            raise ValueError("available enrichment requires citations")
+        return self
+
+
+class Relation(PublicRecord):
+    relation_id: PublicUuid
+    relation_type: Literal[
+        "same_event",
+        "affects_component_version",
+        "mapped_atlas",
+        "related_paper",
+        "remediated_by",
+        "component_version_vulnerability",
+    ]
+    subject_id: PublicUuid
+    object_id: PublicUuid
+    source_revision: PublicUuid
+    citations: tuple[Citation, ...] = Field(max_length=100)
+    rule_or_model_version: Text
+    reason: Text
+    status: ClaimStatus
+
+    @model_validator(mode="after")
+    def require_supported_evidence(self) -> Relation:
+        if self.status == "supported" and not self.citations:
+            raise ValueError("supported relation requires citations")
+        return self
+
+
+class NormalizedIntel(PublicRecord):
+    intel_id: PublicUuid
+    revision_id: PublicUuid
+    title: Text
+    kind: Literal["advisory", "article", "paper", "repository_record", "standard", "policy"]
+    external_ids: tuple[Text, ...] = Field(max_length=100)
+    citations: tuple[Citation, ...] = Field(max_length=100)
+    data_mode: DataMode
+
+
+class Vulnerability(PublicRecord):
+    intel_id: PublicUuid
+    event_id: PublicUuid
+    title: Text
+    external_ids: tuple[Text, ...] = Field(max_length=100)
+    enrichments: tuple[Enrichment, ...] = Field(max_length=9)
+    relations: tuple[Relation, ...] = Field(max_length=100)
+    freshness: Freshness
+
+
+class Advisory(PublicRecord):
+    intel_id: PublicUuid
+    revision_id: PublicUuid
+    title: Text
+    source_uri: AbsoluteUri
+    published_at: PublicDateTime | None
+    citations: tuple[Citation, ...] = Field(max_length=100)
+
+
+class AnswerClaim(PublicRecord):
+    text: Text
+    kind: Literal["source_fact", "rule_result", "project_suggestion"]
+    support_ids: tuple[PublicUuid, ...] = Field(max_length=100)
+
+    @model_validator(mode="after")
+    def require_fact_support(self) -> AnswerClaim:
+        if self.kind != "project_suggestion" and not self.support_ids:
+            raise ValueError("facts require support")
+        return self
+
+
+class QAAnswer(PublicRecord):
+    kind: Literal["completed"]
+    answer_id: PublicUuid
+    answer_text: str
+    claims: tuple[AnswerClaim, ...] = Field(max_length=100)
+    citations: tuple[Citation, ...] = Field(max_length=100)
+    limitations: tuple[Text, ...] = Field(max_length=100)
+    freshness: Freshness
+    data_mode: DataMode
+    started_at: PublicDateTime
+    completed_at: PublicDateTime
+    latency_milliseconds: int = Field(ge=0)
+
+    @model_validator(mode="after")
+    def require_complete_support_and_timing(self) -> QAAnswer:
+        evidence_ids = [citation.evidence_id for citation in self.citations]
+        if len(evidence_ids) != len(set(evidence_ids)):
+            raise ValueError("citations must be unique")
+        if any(set(claim.support_ids) - set(evidence_ids) for claim in self.claims):
+            raise ValueError("claim support is not present in citations")
+        if self.completed_at < self.started_at:
+            raise ValueError("answer completion precedes start")
+        return self
+
+
+class TaskHandle(PublicRecord):
+    kind: Literal["task"]
+    task_id: PublicUuid
+    status: Literal["queued", "running", "retry_wait", "waiting_approval", "partial"]
+    poll_uri: Annotated[str, Field(pattern=r"^/api/v1/tasks/")]
+    created_at: PublicDateTime
+
+    @model_validator(mode="after")
+    def require_bound_poll_uri(self) -> TaskHandle:
+        if self.poll_uri != f"/api/v1/tasks/{self.task_id}":
+            raise ValueError("task polling URI does not match its ID")
+        return self
+
+
+AskResult = Annotated[QAAnswer | TaskHandle, Field(discriminator="kind")]
+ASK_RESULT_ADAPTER: TypeAdapter[AskResult] = TypeAdapter(AskResult)
+
+
+class AskRequest(PublicRecord):
+    question: Annotated[str, Field(min_length=1, max_length=4096)]
+    conversation_id: PublicUuid | None = None
+    asset_ids: tuple[PublicUuid, ...] = Field(default=(), max_length=20)
+    event_ids: tuple[PublicUuid, ...] = Field(default=(), max_length=20)
+    mode: Literal["auto", "library", "investigate"]
+    known_at: PublicDateTime | None = None
+    valid_at: PublicDateTime | None = None
+
+    @model_validator(mode="after")
+    def validate_question_boundary(self) -> AskRequest:
+        if not self.question.strip() or "\0" in self.question:
+            raise ValueError("question must be nonempty text")
+        try:
+            self.question.encode("utf-8")
+        except UnicodeError:
+            raise ValueError("question must be valid UTF-8") from None
+        for name in ("conversation_id", "known_at", "valid_at"):
+            if name in self.model_fields_set and getattr(self, name) is None:
+                raise ValueError("omitted optional fields cannot be explicitly null")
+        if any(
+            value is not None and value.tzinfo is None for value in (self.known_at, self.valid_at)
+        ):
+            raise ValueError("question timestamps require timezones")
+        return self
+
+
+class StackCheckRequest(PublicRecord):
+    components: tuple[Component, ...] = Field(max_length=200)
+
+
+class ComponentAssessment(PublicRecord):
+    component: Component
+    status: AssessmentStatus
+    reason_code: Text
+    assessment_id: PublicUuid | None
+    citations: tuple[Citation, ...] = Field(max_length=100)
+    freshness: Freshness
+
+    @model_validator(mode="after")
+    def preserve_unknown_reasons(self) -> ComponentAssessment:
+        if (
+            self.reason_code
+            in {"no_match", "unsupported", "unsupported_rule", "unsupported_ecosystem"}
+            and self.status != "insufficient_evidence"
+        ):
+            raise ValueError("unsupported and no-match reasons require insufficient evidence")
+        return self
+
+
+class StackCheckResult(PublicRecord):
+    kind: Literal["completed"]
+    results: tuple[ComponentAssessment, ...] = Field(max_length=200)
+    limitations: tuple[Text, ...] = Field(max_length=100)
+
+
+class StackUploadRequest(PublicRecord):
+    upload_id: PublicUuid
+    size_bytes: int = Field(ge=1, le=10485760)
+    declared_component_count: int = Field(ge=1, le=10000)
+    format: Literal[
+        "requirements_txt", "package_lock", "sbom_cyclonedx", "json_components", "csv_components"
+    ]
