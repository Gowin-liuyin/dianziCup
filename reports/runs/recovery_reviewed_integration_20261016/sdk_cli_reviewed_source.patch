+    Component,
+    Enrichment,
+    NormalizedIntel,
+    QAAnswer,
+    Relation,
+    StackCheckRequest,
+    StackCheckResult,
+    StackUploadRequest,
+    TaskHandle,
+    Vulnerability,
+)
+from pydantic import TypeAdapter, ValidationError
+
+ROOT = Path(__file__).resolve().parents[3]
+ID = "00000000-0000-4000-8000-000000000001"
+CITATION = {
+    "evidence_id": ID,
+    "revision_id": ID,
+    "quote": "synthetic evidence",
+    "locator": "paragraph:1",
+    "source_uri": "https://example.org/synthetic-advisory",
+}
+ENRICHMENT = {
+    "dimension": "cwe",
+    "status": "available",
+    "claim_ids": [ID],
+    "citations": [CITATION],
+    "freshness": "current",
+    "observed_at": None,
+    "source_version": "synthetic-1",
+    "error_code": None,
+}
+RELATION = {
+    "relation_id": ID,
+    "relation_type": "same_event",
+    "subject_id": ID,
+    "object_id": ID,
+    "source_revision": ID,
+    "citations": [CITATION],
+    "rule_or_model_version": "synthetic-1",
+    "reason": "explicit synthetic identifier",
+    "status": "supported",
+}
+COMPONENT = {"ecosystem": "PyPI", "package_name": "synthetic-package", "version": None}
