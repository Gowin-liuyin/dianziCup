+
+    with (
+        DianziClient(
+            "http://127.0.0.1:12345",
+            SecretStr(SYNTHETIC_KEY),
+            transport=httpx.MockTransport(forbidden),
+        ) as client,
+        pytest.raises(ClientInputError),
+    ):
