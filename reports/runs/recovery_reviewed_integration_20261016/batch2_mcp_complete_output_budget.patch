+    "D:/dianzi-runtime-cache/tiktoken-o200k-base-20261016/fb374d419588a4632f3f557e76b4b70aebbca790"
+)
+KEY = "synthetic-test-key-with-no-provider-access"
+ID = "00000000-0000-4000-8000-000000000001"
+ANSWER = {
