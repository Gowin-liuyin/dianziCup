@@ -0,0 +1,97 @@
+"""CLI input/output for actual backend calls; credentials come only from environment."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from collections.abc import Sequence
+from pathlib import Path
+from typing import Never
+
+from pydantic import ValidationError
+
+from ai_intel_client.client import (
+    ClientConfigurationError,
+    ClientInputError,
+    DianziApiError,
+    DianziClient,
+    DianziTransportError,
+    ResponseContractError,
+    validate_json_bytes,
+)
+from ai_intel_client.models import AskRequest, StackCheckRequest, StackCheckResult
+
+MAX_INPUT_BYTES = 1048576
+
+
+class ClientArgumentParser(argparse.ArgumentParser):
+    def error(self, message: str) -> Never:
+        raise ClientInputError("command arguments are invalid")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = ClientArgumentParser(prog="dianzi-intel")
+    subcommands = parser.add_subparsers(dest="command", required=True)
+    for name in ("check", "ask"):
+        operation = subcommands.add_parser(name)
+        operation.add_argument(
+            "--input", type=Path, help="Explicit JSON file; otherwise read stdin"
+        )
+        operation.add_argument("--idempotency-key", help="Operation key, never an API credential")
+    return parser
+
+
+def _read_input(path: Path | None) -> bytes:
+    if path is None:
+        raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
+    else:
+        with path.open("rb") as source:
+            raw = source.read(MAX_INPUT_BYTES + 1)
+    if len(raw) > MAX_INPUT_BYTES:
+        raise ClientInputError("input exceeds the synchronous client size boundary")
+    validate_json_bytes(raw)
+    return raw
+
+
+def legacy_stack_exit_code(result: StackCheckResult) -> int:
+    """The frozen legacy result has no risk confirmation; no inference can justify 0/1."""
+    return 2
+
+
+def main(arguments: Sequence[str] | None = None) -> int:
+    try:
+        options = build_parser().parse_args(arguments)
+        with DianziClient.from_environment() as client:
+            raw = _read_input(options.input)
+            if options.command == "check":
+                checked = client.check_stack(
+                    StackCheckRequest.model_validate_json(raw),
+                    idempotency_key=options.idempotency_key,
+                )
+                sys.stdout.write(checked.wire_json(ensure_ascii=True) + "\n")
+                sys.stderr.write("Risk classification is unavailable; retain uncertainty.\n")
+                return legacy_stack_exit_code(checked)
+            answer = client.ask(
+                AskRequest.model_validate_json(raw), idempotency_key=options.idempotency_key
+            )
+            sys.stdout.write(answer.wire_json(ensure_ascii=True) + "\n")
+            sys.stderr.write(
+                "A returned answer or task handle does not establish risk certainty.\n"
+            )
+            return 2
+    except (
+        ClientConfigurationError,
+        ClientInputError,
+        ResponseContractError,
+        DianziApiError,
+        DianziTransportError,
+        ValidationError,
+        OSError,
+        UnicodeError,
+    ):
+        sys.stderr.write("The operation could not be completed; check configuration and access.\n")
+        return 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/sdk/python/ai_intel_client/client.py b/sdk/python/ai_intel_client/client.py
new file mode 100644
index 00000000..2395d032
--- /dev/null
+++ b/sdk/python/ai_intel_client/client.py
@@ -0,0 +1,335 @@
+"""Bounded fixed-path HTTP operations against the project's shared backend."""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+import re
+import secrets
+from collections.abc import Mapping
+from typing import TypeVar
+from urllib.parse import urlsplit
+
+import httpx
+from pydantic import (
+    BaseModel,
+    ConfigDict,
+    Field,
+    JsonValue,
+    SecretStr,
+    TypeAdapter,
+    ValidationError,
+)
+
+from ai_intel_client.models import (
+    ASK_RESULT_ADAPTER,
+    AskRequest,
+    AskResult,
+    QAAnswer,
+    StackCheckRequest,
+    StackCheckResult,
+    TaskHandle,
+)
+
+MAX_RESPONSE_BYTES = 1048576
+MAX_SYNCHRONOUS_REQUEST_BYTES = 1048576
+ResultType = TypeVar("ResultType")
+
+
+class ClientConfigurationError(ValueError):
+    """Missing or unsafe client configuration; no configuration value is echoed."""
+
+
+class ClientInputError(ValueError):
+    """Invalid local input before a backend request was sent."""
+
+
+class ResponseContractError(ValueError):
+    """The backend result did not satisfy the frozen response boundary."""
+
+
+class ApiErrorDetails(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, hide_input_in_errors=True)
+    code: str = Field(pattern=r"^[a-z][a-z0-9_]{0,99}$")
+    message: str
+    retryable: bool
+    details: dict[str, JsonValue]
+
+
+class ApiProblem(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, hide_input_in_errors=True)
+    type: str
+    title: str
+    status: int = Field(ge=400, le=599)
+    detail: str
+    instance: str
+    error: ApiErrorDetails
+    trace_id: str = Field(pattern=r"^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")
+
+
+class DianziApiError(RuntimeError):
+    """Public fixed error metadata, without server text or response bodies in logs."""
+
+    def __init__(self, status: int, code: str, trace_id: str | None, retryable: bool) -> None:
+        super().__init__(f"backend request failed: HTTP {status}")
+        self.status = status
+        self.code = code
+        self.trace_id = trace_id
+        self.retryable = retryable
+
+
+class DianziTransportError(RuntimeError):
+    """A POST may have executed; callers can query or reuse its operation key."""
+
+    def __init__(self, idempotency_key: str, may_have_executed: bool) -> None:
+        super().__init__("backend request could not be completed")
+        self.idempotency_key = idempotency_key
+        self.may_have_executed = may_have_executed
+
+
+def _unique_json_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _reject_nonfinite_json(_: str) -> object:
+    raise ValueError("nonfinite JSON number")
+
+
+def _parse_finite_float(value: str) -> float:
+    parsed = float(value)
+    if not math.isfinite(parsed):
+        raise ValueError("nonfinite JSON number")
+    return parsed
+
+
+def validate_json_bytes(raw: bytes) -> None:
+    """Reject duplicate fields and invalid JSON before typed validation chooses values."""
+    try:
+        json.loads(
+            raw,
+            object_pairs_hook=_unique_json_object,
+            parse_constant=_reject_nonfinite_json,
+            parse_float=_parse_finite_float,
+        )
+    except (ValueError, UnicodeError, RecursionError):
+        raise ResponseContractError("response JSON is invalid") from None
+
+
+def _validate_base_url(value: str) -> str:
+    try:
+        parsed = urlsplit(value)
+        port = parsed.port
+        http_allowed = parsed.scheme == "http" and parsed.hostname in {
+            "127.0.0.1",
+            "localhost",
+            "::1",
+        }
+        if (
+            not value
+            or value != value.strip()
+            or any(ord(character) <= 32 for character in value)
+            or parsed.scheme not in {"http", "https"}
+            or (parsed.scheme == "http" and not http_allowed)
+            or not parsed.hostname
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+            or (port is not None and port == 0)
+        ):
+            raise ValueError("invalid base URL")
+        httpx.URL(value)
+    except (ValueError, httpx.InvalidURL):
+        raise ClientConfigurationError("backend base URL is invalid") from None
+    return value.rstrip("/")
+
+
+def _validate_operation_key(value: str) -> str:
+    if re.fullmatch(r"[\x21-\x7e]{1,200}", value) is None:
+        raise ClientInputError("operation key is invalid")
+    return value
+
+
+def _remove_cookie_authentication(request: httpx.Request) -> None:
+    """A server's Set-Cookie must not turn subsequent Bearer calls into cookie calls."""
+    request.headers.pop("cookie", None)
+
+
+class DianziClient:
+    """No retries, arbitrary URLs, database credentials or duplicated business decisions."""
+
+    def __init__(
+        self,
+        base_url: str,
+        api_key: SecretStr,
+        *,
+        timeout_seconds: float = 10,
+        question_timeout_seconds: float = 100,
+        transport: httpx.BaseTransport | None = None,
+    ) -> None:
+        origin = _validate_base_url(base_url)
+        if not isinstance(api_key, SecretStr):
+            raise ClientConfigurationError("API key must use SecretStr")
+        credential = api_key.get_secret_value()
+        if (
+            not 32 <= len(credential) <= 4096
+            or re.fullmatch(r"[A-Za-z0-9._~+/-]+=*", credential) is None
+        ):
+            raise ClientConfigurationError("API key is invalid")
+        if (
+            type(timeout_seconds) not in {int, float}
+            or type(question_timeout_seconds) not in {int, float}
+            or not 0 < timeout_seconds <= 60
+            or not 0 < question_timeout_seconds <= 120
+        ):
+            raise ClientConfigurationError("client timeout is outside the allowed bounds")
+        self._question_timeout_seconds = question_timeout_seconds
+        self._timeout_seconds = timeout_seconds
+        self._http = httpx.Client(
+            base_url=origin,
+            headers={
+                "Authorization": "Bearer " + credential,
+                "Accept": "application/json",
+                "Accept-Encoding": "identity",
+            },
+            timeout=timeout_seconds,
+            follow_redirects=False,
+            trust_env=False,
+            transport=transport,
+            event_hooks={"request": [_remove_cookie_authentication]},
+        )
+
+    @classmethod
+    def from_environment(cls, environment: Mapping[str, str] | None = None) -> DianziClient:
+        configured = os.environ if environment is None else environment
+        base_url = configured.get("DIANZI_API_BASE_URL")
+        key = configured.get("DIANZI_API_KEY")
+        if not base_url or not key:
+            raise ClientConfigurationError("backend base URL and API key must be configured")
+        return cls(base_url, SecretStr(key))
+
+    def close(self) -> None:
+        self._http.close()
+
+    def __enter__(self) -> DianziClient:
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+    def _post(
+        self,
+        path: str,
+        body: str,
+        operation_key: str,
+        adapter: TypeAdapter[ResultType],
+        timeout_seconds: float,
+    ) -> tuple[int, ResultType]:
+        encoded = body.encode("utf-8")
+        if len(encoded) > MAX_SYNCHRONOUS_REQUEST_BYTES:
+            raise ClientInputError("synchronous request exceeds the client size boundary")
+        try:
+            with self._http.stream(
+                "POST",
+                path,
+                content=encoded,
+                headers={"Content-Type": "application/json", "Idempotency-Key": operation_key},
+                timeout=timeout_seconds,
+            ) as response:
+                if response.headers.get("content-encoding", "identity").lower() != "identity":
+                    raise ResponseContractError(
+                        "compressed response is outside the client boundary"
+                    )
+                raw = bytearray()
+                for chunk in response.iter_bytes():
+                    if len(raw) + len(chunk) > MAX_RESPONSE_BYTES:
+                        raise ResponseContractError("response exceeds the allowed size")
+                    raw.extend(chunk)
+                content = bytes(raw)
+                if response.status_code not in {200, 202}:
+                    problem = None
+                    if (
+                        response.headers.get("content-type", "").split(";", 1)[0].lower()
+                        == "application/problem+json"
+                    ):
+                        try:
+                            validate_json_bytes(content)
+                            problem = ApiProblem.model_validate_json(content)
+                        except (ResponseContractError, ValidationError):
+                            problem = None
+                    if problem is None or problem.status != response.status_code:
+                        raise DianziApiError(response.status_code, "http_error", None, False)
+                    raise DianziApiError(
+                        problem.status,
+                        problem.error.code,
+                        problem.trace_id,
+                        problem.error.retryable,
+                    )
+                if (
+                    response.headers.get("content-type", "").split(";", 1)[0].lower()
+                    != "application/json"
+                ):
+                    raise ResponseContractError("response content type is invalid")
+                validate_json_bytes(content)
+                try:
+                    result = adapter.validate_json(content)
+                except ValidationError:
+                    raise ResponseContractError(
+                        "response does not match the public contract"
+                    ) from None
+                return response.status_code, result
+        except httpx.HTTPError:
+            raise DianziTransportError(operation_key, True) from None
+
+    def ask(self, request: AskRequest, *, idempotency_key: str | None = None) -> AskResult:
+        if not isinstance(request, AskRequest):
+            raise ClientInputError("question request is invalid")
+        try:
+            validated = AskRequest.model_validate_json(request.wire_json())
+        except (ValidationError, UnicodeError, ValueError):
+            raise ClientInputError("question request is invalid") from None
+        key = _validate_operation_key(
+            secrets.token_urlsafe(32) if idempotency_key is None else idempotency_key
+        )
+        status, result = self._post(
+            "/api/v1/ask",
+            validated.wire_json(),
+            key,
+            ASK_RESULT_ADAPTER,
+            self._question_timeout_seconds,
+        )
+        if (isinstance(result, QAAnswer) and status != 200) or (
+            isinstance(result, TaskHandle) and status != 202
+        ):
+            raise ResponseContractError("answer kind does not match HTTP status")
+        return result
+
+    def check_stack(
+        self, request: StackCheckRequest, *, idempotency_key: str | None = None
+    ) -> StackCheckResult:
+        if not isinstance(request, StackCheckRequest):
+            raise ClientInputError("stack request is invalid")
+        try:
+            validated = StackCheckRequest.model_validate_json(request.wire_json())
+        except (ValidationError, UnicodeError, ValueError):
+            raise ClientInputError("stack request is invalid") from None
+        key = _validate_operation_key(
+            secrets.token_urlsafe(32) if idempotency_key is None else idempotency_key
+        )
+        status, result = self._post(
+            "/api/v1/stack/check",
+            validated.wire_json(),
+            key,
+            TypeAdapter(StackCheckResult),
+            self._timeout_seconds,
+        )
+        if status != 200:
+            raise ResponseContractError("synchronous stack result requires HTTP 200")
+        return result
diff --git a/sdk/python/ai_intel_client/mcp_adapter.py b/sdk/python/ai_intel_client/mcp_adapter.py
new file mode 100644
index 00000000..23a6b393
--- /dev/null
+++ b/sdk/python/ai_intel_client/mcp_adapter.py
@@ -0,0 +1,205 @@
+"""Official MCP transport handlers for the currently frozen read-tool DTOs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import AsyncIterator, Mapping
+from contextlib import asynccontextmanager
+from functools import partial
+
+import anyio
+from mcp.server.context import ServerRequestContext
+from mcp.server.lowlevel import Server
+from mcp.shared.exceptions import MCPError
+from mcp_types import (
+    SERVER_INFO_META_KEY,
+    CallToolRequestParams,
+    CallToolResult,
+    ListToolsResult,
+    PaginatedRequestParams,
+    TextContent,
+    Tool,
+    ToolAnnotations,
+)
+from mcp_types.jsonrpc import INVALID_PARAMS
+from pydantic import ValidationError
+from starlette.requests import Request
+
+from ai_intel_client.client import (
+    ClientInputError,
+    DianziApiError,
+    DianziClient,
+    DianziTransportError,
+    ResponseContractError,
+)
+from ai_intel_client.models import (
+    ASK_RESULT_ADAPTER,
+    AskRequest,
+    PublicRecord,
+    QAAnswer,
+    StackCheckRequest,
+    StackCheckResult,
+)
+from ai_intel_client.output_budget import McpOutputBudget as McpOutputBudget
+from ai_intel_client.output_budget import OutputBudgetTokenizationError
+
+SERVER_NAME = "dianzi-current-read-tools"
+SERVER_VERSION = "0.1.0"
+
+
+def _result_metadata() -> dict[str, object]:
+    return {SERVER_INFO_META_KEY: {"name": SERVER_NAME, "version": SERVER_VERSION}}
+
+
+def _tool_error(code: str) -> CallToolResult:
+    return CallToolResult(
+        _meta=_result_metadata(),
+        is_error=True,
+        content=[TextContent(text=json.dumps({"error": {"code": code}}, separators=(",", ":")))],
+    )
+
+
+def _complete_result(record: PublicRecord, budget: McpOutputBudget) -> CallToolResult:
+    text = record.wire_json()
+    result = CallToolResult(
+        _meta=_result_metadata(),
+        content=[TextContent(text=text)],
+        structured_content=json.loads(text),
+    )
+    if not budget.fits(result):
+        citations = []
+        if isinstance(record, QAAnswer):
+            citations = [citation.model_dump(mode="json") for citation in record.citations]
+        elif isinstance(record, StackCheckResult):
+            citations = [
+                citation.model_dump(mode="json")
+                for assessment in record.results
+                for citation in assessment.citations
+            ]
+        details = {
+            "code": "output_budget_exceeded",
+            "budget_profile": budget.profile,
+            "complete": False,
+            "result_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
+            "pagination": "not_configured",
+            "references_status": "complete",
+            "citations": citations,
+        }
+        error = CallToolResult(
+            _meta=_result_metadata(),
+            is_error=True,
+            content=[TextContent(text=json.dumps({"error": details}, separators=(",", ":")))],
+        )
+        if budget.fits(error):
+            return error
+        details["references_status"] = "unavailable_within_budget"
+        details.pop("citations")
+        return CallToolResult(
+            _meta=_result_metadata(),
+            is_error=True,
+            content=[TextContent(text=json.dumps({"error": details}, separators=(",", ":")))],
+        )
+    return result
+
+
+@asynccontextmanager
+async def _server_lifespan(_: Server[None]) -> AsyncIterator[None]:
+    yield None
+
+
+def create_current_read_tool_server(
+    client: DianziClient,
+    output_budget: McpOutputBudget,
+) -> Server[None]:
+    """Expose only implemented shared-backend calls; no HTTP auth or invented endpoints.
+
+    The owning runtime must verify its tokenizer/cache and authenticate transport
+    requests before exposing this server. HTTP clients must have a request-bound
+    credential; the fixed client supplied here is intended for one stdio identity.
+    """
+    request_models: dict[str, type[PublicRecord]] = {
+        "ask": AskRequest,
+        "check_stack": StackCheckRequest,
+    }
+    output_schemas = {
+        "ask": {"type": "object", **ASK_RESULT_ADAPTER.json_schema()},
+        "check_stack": StackCheckResult.model_json_schema(),
+    }
+    tools = [
+        Tool(
+            name=name,
+            description=(
+                "Ask the shared backend with traceable source support."
+                if name == "ask"
+                else "Check component applicability; absence of a match remains unknown."
+            ),
+            input_schema=model.model_json_schema(),
+            output_schema=output_schemas[name],
+            annotations=ToolAnnotations(
+                read_only_hint=True, destructive_hint=False, open_world_hint=True
+            ),
+        )
+        for name, model in request_models.items()
+    ]
+    worker_slots = anyio.CapacityLimiter(4)
+
+    async def list_tools(
+        _: ServerRequestContext[None, Request], params: PaginatedRequestParams | None
+    ) -> ListToolsResult:
+        if params is not None and params.cursor is not None:
+            raise MCPError(INVALID_PARAMS, "tool discovery cursor is invalid")
+        return ListToolsResult(tools=tools)
+
+    async def call_tool(
+        context: ServerRequestContext[None, Request], params: CallToolRequestParams
+    ) -> CallToolResult:
+        if context.request is not None:
+            return _tool_error("not_configured")
+        if params.name not in request_models:
+            return _tool_error("unknown_tool")
+        try:
+            raw = json.dumps(params.arguments or {}, allow_nan=False).encode("utf-8")
+            validated_request = request_models[params.name].model_validate_json(raw)
+        except (ValidationError, UnicodeError, ValueError):
+            return _tool_error("invalid_arguments")
+        record: PublicRecord
+        try:
+            if params.name == "ask":
+                if not isinstance(validated_request, AskRequest):
+                    return _tool_error("invalid_arguments")
+                record = await anyio.to_thread.run_sync(
+                    partial(client.ask, validated_request), limiter=worker_slots
+                )
+            else:
+                if not isinstance(validated_request, StackCheckRequest):
+                    return _tool_error("invalid_arguments")
+                record = await anyio.to_thread.run_sync(
+                    partial(client.check_stack, validated_request), limiter=worker_slots
+                )
+            return _complete_result(record, output_budget)
+        except ClientInputError:
+            return _tool_error("backend_request_error")
+        except DianziApiError as error:
+            return _tool_error(error.code)
+        except DianziTransportError:
+            return _tool_error("backend_transport_error")
+        except ResponseContractError:
+            return _tool_error("backend_contract_error")
+        except OutputBudgetTokenizationError:
+            return _tool_error("tokenizer_unavailable")
+        except Exception:
+            return _tool_error("backend_internal_error")
+
+    def input_schema(name: str) -> Mapping[str, object] | None:
+        model = request_models.get(name)
+        return None if model is None else model.model_json_schema()
+
+    return Server(
+        SERVER_NAME,
+        version=SERVER_VERSION,
+        lifespan=_server_lifespan,
+        on_list_tools=list_tools,
+        on_call_tool=call_tool,
+        get_tool_input_schema=input_schema,
+    )
diff --git a/sdk/python/ai_intel_client/mcp_stdio.py b/sdk/python/ai_intel_client/mcp_stdio.py
new file mode 100644
index 00000000..c4035e68
--- /dev/null
+++ b/sdk/python/ai_intel_client/mcp_stdio.py
@@ -0,0 +1,38 @@
+"""One-identity stdio entry point with the pinned offline output tokenizer."""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import sys
+from pathlib import Path
+
+from mcp.server.stdio import stdio_server
+
+from ai_intel_client.client import ClientConfigurationError, DianziClient
+from ai_intel_client.mcp_adapter import create_current_read_tool_server
+from ai_intel_client.output_budget import McpOutputBudget, OutputBudgetConfigurationError
+
+
+async def serve_stdio() -> None:
+    cache_file = os.environ.get("DIANZI_MCP_ENCODING_CACHE_FILE")
+    if not cache_file:
+        raise OutputBudgetConfigurationError("not_configured")
+    budget = McpOutputBudget(Path(cache_file))
+    with DianziClient.from_environment() as backend:
+        server = create_current_read_tool_server(backend, budget)
+        async with stdio_server() as (read_stream, write_stream):
+            await server.run(read_stream, write_stream, server.create_initialization_options())
+
+
+def main() -> int:
+    try:
+        asyncio.run(serve_stdio())
+    except (ClientConfigurationError, OutputBudgetConfigurationError):
+        sys.stderr.write('{"error":{"code":"not_configured"}}\n')
+        return 3
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
