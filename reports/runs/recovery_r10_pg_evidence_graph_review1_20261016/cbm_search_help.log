Usage:
  codebase-memory-mcp cli search_graph --flag value [--flag2 value2 ...]
  codebase-memory-mcp cli search_graph --args-file <path-to-json>
  echo '<json>' | codebase-memory-mcp cli search_graph
  codebase-memory-mcp cli search_graph '<raw-json-args>'

Flags:
  --project <string> [required]
  --query <string>
  --label <string>
  --name-pattern <string>
  --qn-pattern <string>
  --file-pattern <string>
  --relationship <string>
  --min-degree <integer>
  --max-degree <integer>
  --exclude-entry-points <boolean>
  --include-connected <boolean>
  --semantic-query <array>  Not with query.
  --semantic-limit <integer> [default: 50]
  --semantic-offset <integer> [default: 0]
  --limit <integer> [default: 50]
  --offset <integer> [default: 0]
  --max-output-tokens <integer> [default: 3200]
  --format <tree|json> [default: tree]
  --fields <array>
  --detail <ids|default> [default: default]
