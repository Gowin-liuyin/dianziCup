        "sqltext": "condition_sha256 ~ '^[0-9a-f]{64}$'::text",
        "comment": null
      },
      {
        "name": "ck_rule_payload",
        "sqltext": "jsonb_typeof(rule_payload) = 'object'::text",
        "comment": null
      },
      {
        "name": "ck_rule_published_time",
        "sqltext": "(status = ANY (ARRAY['published'::text, 'retired'::text])) = (published_at IS NOT NULL)",
        "comment": null
      },
      {
        "name": "ck_rule_retired_time",
        "sqltext": "(status = 'retired'::text) = (retired_at IS NOT NULL)",
        "comment": null
      },
      {
        "name": "ck_rule_reviewer",
        "sqltext": "published_by IS NULL OR published_by <> author_user_id",
        "comment": null
      }
