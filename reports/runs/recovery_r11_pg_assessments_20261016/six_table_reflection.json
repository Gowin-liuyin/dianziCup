        "name": "ck_condition_rule_kind",
        "sqltext": "rule_kind = ANY (ARRAY['software_applicability'::text, 'observed_path'::text, 'research_prerequisites'::text])",
        "comment": null
      },
      {
        "name": "ck_condition_rule_status",
        "sqltext": "status = ANY (ARRAY['candidate'::text, 'validated'::text, 'published'::text, 'retired'::text])",
