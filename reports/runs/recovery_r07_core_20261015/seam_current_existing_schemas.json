{
  "projection": {
    "$defs": {
      "CitationProjection": {
        "additionalProperties": false,
        "description": "\u5f15\u7528\u4fdd\u7559\u7248\u672c\u4e0e\u5b9a\u4f4d\uff1b\u5b83\u7684\u5b58\u5728\u672c\u8eab\u4e0d\u8bc1\u660e\u652f\u6491\u5173\u7cfb\u3002",
        "properties": {
          "evidence_id": {
            "format": "uuid",
            "title": "Evidence Id",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "quote": {
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "title": "Revision Id",
            "type": "string"
          },
          "source_uri": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Uri",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "revision_id",
          "quote",
          "locator",
          "source_uri"
        ],
        "title": "CitationProjection",
        "type": "object"
      },
      "DimensionStatus": {
        "description": "\u5bcc\u5316\u7ef4\u5ea6\u72b6\u6001: not_applicable \u4e0d\u8ba1\u7f3a\u5931, not_found \u8ba1\u53ec\u56de\u635f\u5931\u3002",
        "enum": [
          "available",
          "not_found",
          "not_applicable",
          "conflict",
          "blocked",
          "failed",
          "pending"
        ],
        "title": "DimensionStatus",
        "type": "string"
      },
      "FreshnessStatus": {
        "description": "\u65f6\u6548\u72b6\u6001: \u7f3a\u89c2\u5bdf\u65f6\u95f4\u4e0d\u5f97\u586b current\u3002",
        "enum": [
          "current",
          "stale",
          "unknown"
        ],
        "title": "FreshnessStatus",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "\u4e5d\u7ef4\u516c\u5171\u54cd\u5e94\uff0c\u4e0d\u6cc4\u9732\u5185\u90e8job/scope\u5b57\u6bb5\u3002",
    "properties": {
      "citations": {
        "items": {
          "$ref": "#/$defs/CitationProjection"
        },
        "maxItems": 100,
        "title": "Citations",
        "type": "array"
      },
      "claim_ids": {
        "items": {
          "format": "uuid",
          "type": "string"
        },
        "maxItems": 100,
        "title": "Claim Ids",
        "type": "array"
      },
      "dimension": {
        "enum": [
          "cvss",
          "epss",
          "kev",
          "cwe",
          "atlas",
          "versions",
          "literature",
          "poc",
          "exposure"
        ],
        "title": "Dimension",
        "type": "string"
      },
      "error_code": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Error Code"
      },
      "freshness": {
        "$ref": "#/$defs/FreshnessStatus"
      },
      "observed_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Observed At"
      },
      "source_version": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Source Version"
      },
      "status": {
        "$ref": "#/$defs/DimensionStatus"
      }
    },
    "required": [
      "dimension",
      "status",
      "claim_ids",
      "citations",
      "freshness",
      "observed_at",
      "source_version",
      "error_code"
    ],
    "title": "EnrichmentProjection",
    "type": "object"
  },
  "submission": {
    "$defs": {
      "DimensionStatus": {
        "description": "\u5bcc\u5316\u7ef4\u5ea6\u72b6\u6001: not_applicable \u4e0d\u8ba1\u7f3a\u5931, not_found \u8ba1\u53ec\u56de\u635f\u5931\u3002",
        "enum": [
          "available",
          "not_found",
          "not_applicable",
          "conflict",
          "blocked",
          "failed",
          "pending"
        ],
        "title": "DimensionStatus",
        "type": "string"
      },
      "FreshnessStatus": {
        "description": "\u65f6\u6548\u72b6\u6001: \u7f3a\u89c2\u5bdf\u65f6\u95f4\u4e0d\u5f97\u586b current\u3002",
        "enum": [
          "current",
          "stale",
          "unknown"
        ],
        "title": "FreshnessStatus",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "\u5185\u90e8\u6301\u4e45\u5316\u8f93\u5165\u53ea\u5f15\u7528\u5df2\u9a8c\u8bc1\u4e8b\u5b9e\uff0c\u4e0d\u80fd\u76f4\u63a5\u63a5\u6536\u6a21\u578b\u7684\u4efb\u610f\u503c\u3002",
    "properties": {
      "claim_ids": {
        "default": [],
        "items": {
          "format": "uuid",
          "type": "string"
        },
        "maxItems": 100,
        "title": "Claim Ids",
        "type": "array"
      },
      "dimension": {
        "enum": [
          "cvss",
          "epss",
          "kev",
          "cwe",
          "atlas",
          "versions",
          "literature",
          "poc",
          "exposure"
        ],
        "title": "Dimension",
        "type": "string"
      },
      "error_code": {
        "anyOf": [
          {
            "pattern": "^[a-z0-9_]{1,120}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error Code"
      },
      "event_id": {
        "format": "uuid",
        "title": "Event Id",
        "type": "string"
      },
      "expected_event_version": {
        "minimum": 1,
        "title": "Expected Event Version",
        "type": "integer"
      },
      "freshness": {
        "$ref": "#/$defs/FreshnessStatus",
        "default": "unknown"
      },
      "input_fingerprint": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Input Fingerprint",
        "type": "string"
      },
      "last_job_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Last Job Id"
      },
      "observed_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Observed At"
      },
      "reference_ids": {
        "default": [],
        "items": {
          "format": "uuid",
          "type": "string"
        },
        "maxItems": 100,
        "title": "Reference Ids",
        "type": "array"
      },
      "searched_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Searched At"
      },
      "source_ids": {
        "default": [],
        "items": {
          "format": "uuid",
          "type": "string"
        },
        "maxItems": 100,
        "title": "Source Ids",
        "type": "array"
      },
      "source_version": {
        "anyOf": [
          {
            "maxLength": 200,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Source Version"
      },
      "status": {
        "$ref": "#/$defs/DimensionStatus"
      }
    },
    "required": [
      "event_id",
      "dimension",
      "status",
      "expected_event_version",
      "input_fingerprint"
    ],
    "title": "DimensionSubmission",
    "type": "object"
  }
}
