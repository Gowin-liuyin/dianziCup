          "minLength": 1,
          "maxLength": 2048
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor",
        "data_mode"
      ],
      "additionalProperties": false
    },
    "VulnerabilityDetailPage": {
      "type": "object",
      "properties": {
        "vulnerability": {
          "$ref": "#/$defs/Vulnerability"
        },
        "advisories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Advisory"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "mapping_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 100
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "vulnerability",
        "advisories",
        "next_cursor",
        "mapping_limits",
        "data_mode"
      ],
      "additionalProperties": false
    },
    "SourceDescriptor": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "enum": [
            "structured_vulnerability",
            "vendor_advisory",
            "security_community",
            "code_repository",
            "technical_blog",
            "academic_paper",
            "technical_standard",
            "policy_regulation"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "health": {
          "enum": [
            "never_polled",
            "healthy",
            "partial",
            "failed",
            "blocked",
            "unknown"
          ]
        },
        "last_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "source_id",
        "name",
        "category",
        "enabled",
        "health",
        "last_attempt_at",
        "last_success_at",
        "reason_code",
        "data_mode"
      ],
      "additionalProperties": false
    },
    "SourcePage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDescriptor"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor",
        "data_mode"
      ],
      "additionalProperties": false
    },
    "TaskDescriptor": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_type": {
          "enum": [
            "ask",
            "stack_check"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "retry_wait",
            "waiting_approval",
            "succeeded",
            "partial",
            "failed",
            "cancelled",
            "blocked"
          ]
        },
        "poll_uri": {
          "type": "string",
          "pattern": "^/api/v1/tasks/[0-9a-fA-F-]{36}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "task_id",
        "task_type",
        "status",
        "poll_uri",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "PublicProblem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "trace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "error",
        "trace_id"
      ],
      "additionalProperties": false
    },
    "TaskResultEnvelope": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskDescriptor"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/QAAnswer"
            },
            {
              "$ref": "#/$defs/StackCheckEnvelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicProblem"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "pending_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "failed_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "task",
        "result",
        "error",
        "completed_steps",
        "pending_steps",
        "failed_steps"
      ],
      "additionalProperties": false
    }
  }
}
