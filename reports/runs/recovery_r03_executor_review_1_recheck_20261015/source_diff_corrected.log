+    equivalent = page_request_digest(
+        lease(),
+        {},
+        {"next": 1},
+        ({"unknown": {"a": "中文", "b": 2}, "entry_id": "entry"},),
+        True,
+        NOW.astimezone(timezone(timedelta(hours=8))),
+    )
+    changed = page_request_digest(
+        lease(),
+        {},
+        {"next": 1},
