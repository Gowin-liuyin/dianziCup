+def test_request_digest_normalizes_key_order_and_utc_but_retains_all_entry_fields() -> None:
+    from datetime import timezone
+
+    first = page_request_digest(
+        lease(),
+        {},
+        {"next": 1},
+        ({"entry_id": "entry", "unknown": {"b": 2, "a": "中文"}},),
+        True,
+        NOW,
