+.question-citation blockquote { margin: 0; padding-left: 14px; border-left: 1px solid #517868; color: var(--muted); }
+.question-answer-metadata { margin-top: 16px; padding-top: 20px; border-top: 1px solid var(--line); }
+.question-access { padding-bottom: 24px; }
+.question-access > .button { margin-left: 24px; }
+@media (max-width: 1100px) { .question-workspace-grid { grid-template-columns: minmax(0, 1fr); } }
+@media (max-width: 640px) { .question-form, .question-frozen, .question-answer, .question-loading { padding: 18px 16px; } .question-metadata { grid-template-columns: 65px minmax(0, 1fr); gap: 10px; } }
