+.question-workspace { min-width: 0; }
+.question-scope { border-left: 2px solid var(--accent); padding-left: 16px; margin-bottom: 24px; }
+.question-scope p { color: var(--muted); font-size: 13px; }
+.question-mode { color: var(--accent); font-size: 12px; }
+.question-workspace-grid { display: grid; grid-template-columns: minmax(280px, .75fr) minmax(0, 1.5fr); align-items: start; gap: 20px; }
+.question-form { display: grid; gap: 16px; padding: 20px; }
+.question-form label { display: grid; gap: 8px; color: var(--muted); font-size: 12px; min-width: 0; }
+.question-form input, .question-form textarea { width: 100%; min-width: 0; border: 1px solid #405658; background: var(--field); color: var(--ink); padding: 12px; font: inherit; border-radius: 4px; }
+.question-form input { font-family: var(--mono); }
+.question-form textarea { resize: vertical; min-height: 140px; line-height: 1.7; }
+.question-form textarea:focus-visible, .question-citation:focus { outline: 2px solid var(--accent); outline-offset: 3px; }
+.question-form .button { justify-self: start; }
+.question-form p { margin-bottom: 0; }
+.question-frozen, .question-lookup { border-top: 1px solid var(--line); padding: 20px; }
+.question-frozen h3 { color: var(--accent); }
+.question-metadata { display: grid; grid-template-columns: 75px minmax(0, 1fr); gap: 10px 14px; line-height: 1.7; font-size: 12px; }
+.question-metadata dt { color: var(--muted); }
+.question-metadata dd { margin: 0; overflow-wrap: anywhere; min-width: 0; }
+.question-metadata code { font-size: 11px; }
+.question-actions, .question-supports { display: flex; flex-wrap: wrap; gap: 12px; }
+.question-supports a { font-size: 12px; color: var(--accent); }
+.question-loading, .question-answer { padding: 24px; font-size: 13px; overflow-wrap: anywhere; }
+.question-loading { color: var(--muted); }
+.question-answer-status { display: flex; flex-wrap: wrap; gap: 10px 18px; padding-bottom: 20px; margin-bottom: 24px; border-bottom: 1px solid var(--line); font-size: 12px; }
+.question-answer-status strong { font: 12px var(--mono); font-weight: 400; }
+.question-freshness { color: var(--warn); }
+.question-freshness.freshness-current { color: var(--accent); }
+.question-answer-text, .question-citation blockquote { white-space: pre-wrap; line-height: 1.85; }
+.question-claim-group { margin-top: 24px; }
