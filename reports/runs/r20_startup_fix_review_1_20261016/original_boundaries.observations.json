      "command": "D:\\dianzi\\backend\\.venv\\Scripts\\python.exe -c \"import ctypes,gc,os,sys\nfrom ai_intel.infrastructure import process_limits\nif os.name=='nt':\n    from ctypes import wintypes\n    kernel=ctypes.WinDLL('kernel32')\n    kernel.GetCurrentProcess.restype=wintypes.HANDLE\n    kernel.GetProcessHandleCount.argtypes=[wintypes.HANDLE,ctypes.c_void_p]\n    def count_handles():\n        count=wintypes.DWORD()\n        assert kernel.GetProcessHandleCount(kernel.GetCurrentProcess(),ctypes.byref(count))\n        return count.value\n    process_limits.subprocess.run(\n        [os.path.join(sys.base_prefix,'python.exe'),'-I','-S','-c','pass'],\n        stdin=process_limits.subprocess.DEVNULL,\n        stdout=process_limits.subprocess.DEVNULL,\n        stderr=process_limits.subprocess.DEVNULL,timeout=3,check=True)\n    gc.collect()\n    original_popen=process_limits.subprocess.Popen\n    guards=[]\n    def record_guard(*args,**kwargs):\n        guard=original_popen(*args,**kwargs)\n        guards.append(guard)\n        return guard\n    process_limits.subprocess.Popen=record_guard\n    process_limits._WINDOWS_CPU_GUARD_CODE='import time; time.sleep(20)'\n    before=count_handles()\n    try: process_limits.bound_process_resources(memory_bytes=100*1024**2,cpu_seconds=5)\n    except OSError: pass\n    else: raise AssertionError('unready guard allowed work')\n    assert len(guards)==1 and guards[0].poll() is not None\n    guards.clear()\n    gc.collect()\n    after=count_handles()\n    assert after==before, f'setup handle count {before} -> {after}'\nelse:\n    try: process_limits._start_windows_cpu_guard(5,0)\n    except OSError: pass\n    else: raise AssertionError('Windows guard started on another platform')\nprint('FAILURE_CLEANED',flush=True)\n\"",
