reference_kind = 'revision'

    @pytest.mark.parametrize('reference_kind', ['revision', 'fetch_attempt'])
    def test_new_response_reference_during_gc_never_loses_its_raw_bytes(
        own_schema_engine, tmp_path, reference_kind
    ):
        store = ContentStore(tmp_path / 'objects')
        now = datetime.now(UTC)
        response = store.store_bytes(b'{"vulnerabilities":[{"cve":{"id":"CVE-2026-12345"}}]}')
        with Session(own_schema_engine) as session, session.begin():
            seed_document(session, 'document', 'public', None)
            saved = save_document_revision(session, store, 'document', b'{"cve":{}}',
                                           'public', None, now)
            session.execute(content_objects.insert().values(content_hash=response.content_hash,
                size_bytes=response.size_bytes, created_at=now))
            source_id = session.scalar(text("SELECT source_id FROM documents WHERE document_id='document'"))
    
        writer_results = []
    
        def publish_reference():
            with Session(own_schema_engine) as writer, writer.begin():
                if reference_kind == 'revision':
                    writer.execute(update(document_revisions)
                        .where(document_revisions.c.revision_id == saved.revision_id)
                        .values(source_response_hash=response.content_hash,
                                source_json_pointer='/vulnerabilities/0'))
                else:
                    writer.execute(fetch_attempts.insert().values(attempt_id='attempt',
                        source_id=source_id, attempted_at=now, outcome='succeeded',
                        new_event_count=0, response_content_hash=response.content_hash))
            writer_results.append('committed')
    
        class InterleavedStore:
            """Pause at the observable deletion boundary to finish a concurrent FK writer."""
    
            def delete_object(self, content_hash):
                thread = threading.Thread(target=publish_reference)
                thread.start()
                thread.join(timeout=8)
                assert not thread.is_alive() and writer_results == ['committed']
                return store.delete_object(content_hash)
    
        with Session(own_schema_engine) as collector:
            try:
                with collector.begin():
                    cleanup_unreferenced_object(collector, InterleavedStore(), response.content_hash)
            except IntegrityError:
                pass
        with own_schema_engine.connect() as connection:
            retained = connection.scalar(select(content_objects.c.content_hash)
                .where(content_objects.c.content_hash == response.content_hash))
            assert retained == response.content_hash
        readable = True
        try:
            store.read_verified(response.content_hash)
        except FileNotFoundError:
            readable = False
