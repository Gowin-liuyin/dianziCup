diff --git a/backend/tests/contract/test_r01_search_tls_deployment.py b/backend/tests/contract/test_r01_search_tls_deployment.py
new file mode 100644
index 0000000..682b753
--- /dev/null
+++ b/backend/tests/contract/test_r01_search_tls_deployment.py
@@ -0,0 +1,86 @@
+"""R01 安全搜索配置合同；不联网、不读取秘密、不启动服务。"""
+
+from __future__ import annotations
+
+import json
+import secrets
+from urllib.parse import urlsplit
+
+import pytest
+from test_r01_compose_configuration import configuration_environment, render_configuration
+
+
+def test_base_pairs_readonly_ca_with_separate_search_authentication() -> None:
+    environment = configuration_environment()
+    environment.update(
+        COMPOSE_OPENSEARCH_USERNAME="ai_intel_search",
+        COMPOSE_OPENSEARCH_PASSWORD=secrets.token_urlsafe(32),
+        OPENSEARCH_CA_HOST_FILE="/tmp/r01-config-root-ca.pem",
+    )
+    result = render_configuration("compose.yaml", environment)
+    assert result.returncode == 0, result.stderr
+    services = json.loads(result.stdout)["services"]
+    for name in ("api", "worker", "scheduler"):
+        service = services[name]
+        settings = service["environment"]
+        assert urlsplit(settings["OPENSEARCH_URL"]).scheme == "https"
+        assert urlsplit(settings["OPENSEARCH_URL"]).username is None
+        assert settings["OPENSEARCH_USERNAME"] == "ai_intel_search"
+        assert settings["OPENSEARCH_PASSWORD"] == environment["COMPOSE_OPENSEARCH_PASSWORD"]
+        ca_mount = next(
+            volume
+            for volume in service["volumes"]
+            if volume["target"] == settings["OPENSEARCH_CA_FILE"]
+        )
+        assert ca_mount["source"] == "/tmp/r01-config-root-ca.pem"
+        assert ca_mount["read_only"] is True
+        assert ca_mount["bind"]["create_host_path"] is False
+        assert all("node-key" not in volume["target"] for volume in service["volumes"])
+    search = services["opensearch"]
+    health = search["healthcheck"]["test"][-1]
+    assert "--cacert" in health
+    assert "-k" not in health and "--insecure" not in health
+    assert search["environment"]["DISABLE_INSTALL_DEMO_CONFIG"] == "true"
+    assert "DISABLE_SECURITY_PLUGIN" not in search["environment"]
+
+
+def test_base_does_not_supply_a_default_search_identity() -> None:
+    environment = configuration_environment()
+    environment.pop("COMPOSE_OPENSEARCH_USERNAME", None)
+    result = render_configuration("compose.yaml", environment)
+    assert result.returncode == 0, result.stderr
+    services = json.loads(result.stdout)["services"]
+    for name in ("api", "worker", "scheduler", "opensearch"):
+        assert services[name]["environment"]["OPENSEARCH_USERNAME"] == ""
+
+
+@pytest.mark.parametrize("filename", ["compose.test.yaml", "compose.test.host.yaml"])
+def test_http_overlay_explicitly_removes_secure_auth_and_ca(filename: str) -> None:
+    result = render_configuration(filename, configuration_environment())
+    assert result.returncode == 0, result.stderr
+    services = json.loads(result.stdout)["services"]
+    for name in ("api", "worker", "scheduler"):
+        settings = services[name]["environment"]
+        assert settings["OPENSEARCH_URL"].startswith("http://")
+        assert (
+            not {"OPENSEARCH_USERNAME", "OPENSEARCH_PASSWORD", "OPENSEARCH_CA_FILE"}
+            & settings.keys()
+        )
+    search = services["opensearch"]
+    assert search["environment"]["DISABLE_SECURITY_PLUGIN"] == "true"
+    assert not any(volume["type"] == "bind" for volume in search["volumes"])
+
+
+def test_secure_host_profile_keeps_tls_and_loopback_without_published_ports() -> None:
+    environment = configuration_environment()
+    environment.update(SECURE_OPENSEARCH_PORT="29202", SECURE_OPENSEARCH_TRANSPORT_PORT="29302")
+    result = render_configuration("compose.search.secure.host.yaml", environment, "search")
+    assert result.returncode == 0, result.stderr
+    services = json.loads(result.stdout)["services"]
+    assert set(services) == {"opensearch"}
+    search = services["opensearch"]
+    assert search["network_mode"] == "host"
+    assert not search.get("ports")
+    assert search["environment"]["network.host"] == "127.0.0.1"
+    assert "DISABLE_SECURITY_PLUGIN" not in search["environment"]
+    assert "--cacert" in search["healthcheck"]["test"][-1]
diff --git a/backend/tests/integration/test_r01_search_tls_live.py b/backend/tests/integration/test_r01_search_tls_live.py
new file mode 100644
index 0000000..b88e71f
--- /dev/null
+++ b/backend/tests/integration/test_r01_search_tls_live.py
@@ -0,0 +1,170 @@
+"""真实 TLS 信任、认证与安全故障验证，仅使用本包独占搜索资源。"""
+
+from __future__ import annotations
+
+import json
+import os
+import secrets
+import socket
+import ssl
+import subprocess
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from urllib.parse import urlsplit
+
+import pytest
+from fastapi.testclient import TestClient
+from pydantic import SecretStr
+
+from ai_intel.api.app import create_application
+from ai_intel.infrastructure.settings import ApplicationSettings
+
+pytestmark = pytest.mark.real_search_tls
+
+
+@dataclass(frozen=True)
+class SearchTLSConnection:
+    url: str
+    username: str
+    password: SecretStr
+    ca_file: str
+    wrong_ca_file: str
+
+
+@pytest.fixture()
+def real_tls_settings() -> SearchTLSConnection:
+    required = (
+        "TEST_SEARCH_TLS_URL",
+        "TEST_SEARCH_TLS_USERNAME",
+        "TEST_SEARCH_TLS_PASSWORD",
+        "TEST_SEARCH_TLS_CA_FILE",
+        "TEST_SEARCH_TLS_WRONG_CA_FILE",
+    )
+    configured = {name: os.environ.get(name, "") for name in required}
+    if not all(configured.values()):
+        raise pytest.UsageError("blocked: isolated secure OpenSearch TLS resources required")
+    parsed = urlsplit(configured["TEST_SEARCH_TLS_URL"])
+    assert parsed.scheme == "https" and parsed.hostname == "localhost" and parsed.port == 29202
+    assert Path(configured["TEST_SEARCH_TLS_CA_FILE"]).is_file()
+    return SearchTLSConnection(
+        url=configured["TEST_SEARCH_TLS_URL"],
+        username=configured["TEST_SEARCH_TLS_USERNAME"],
+        password=SecretStr(configured["TEST_SEARCH_TLS_PASSWORD"]),
+        ca_file=configured["TEST_SEARCH_TLS_CA_FILE"],
+        wrong_ca_file=configured["TEST_SEARCH_TLS_WRONG_CA_FILE"],
+    )
+
+
+@pytest.mark.parametrize("case", ["correct", "no_ca", "wrong_ca", "wrong_san", "wrong_password"])
+def test_real_search_tls_trust_authentication_and_failure_are_observable(
+    real_tls_settings: SearchTLSConnection, case: str
+) -> None:
+    url = real_tls_settings.url
+    ca: str | None = real_tls_settings.ca_file
+    password = real_tls_settings.password.get_secret_value()
+    if case == "no_ca":
+        ca = None
+    elif case == "wrong_ca":
+        ca = real_tls_settings.wrong_ca_file
+    elif case == "wrong_san":
+        url = url.replace("localhost", "127.0.0.1")
+    elif case == "wrong_password":
+        password = secrets.token_urlsafe(32)
+    settings = ApplicationSettings(
+        app_env="test",
+        data_mode="live",
+        database_url=None,
+        redis_url=None,
+        opensearch_url=url,
+        opensearch_username=real_tls_settings.username,
+        opensearch_password=password,
+        opensearch_ca_file=ca,
+        dependency_timeout_seconds=3,
+    )
+    with TestClient(create_application(settings=settings)) as client:
+        response = client.get("/v1/health/ready")
+    if real_tls_settings.password.get_secret_value() in response.text or password in response.text:
+        pytest.fail("secret present in health response")
+    assert response.status_code == 503
+    payload = response.json()
+    if case == "correct":
+        assert payload["dependencies"]["search"] == {"state": "ready"}
+    else:
+        assert payload["dependencies"]["search"] == {
+            "state": "unavailable",
+            "reason": "search connection unavailable",
+        }
+    assert "Traceback" not in response.text
+
+
+def test_real_certificate_chain_enforces_hostname_and_required_ca(
+    real_tls_settings: SearchTLSConnection,
+) -> None:
+    context = ssl.create_default_context(cafile=real_tls_settings.ca_file)
+    assert context.check_hostname is True
+    assert context.verify_mode == ssl.CERT_REQUIRED
+    with (
+        socket.create_connection(("127.0.0.1", 29202), timeout=3) as connection,
+        context.wrap_socket(connection, server_hostname="localhost") as secured,
+    ):
+        certificate = secured.getpeercert()
+        assert ("DNS", "localhost") in certificate["subjectAltName"]
+        assert ("DNS", "opensearch") in certificate["subjectAltName"]
+
+
+def test_real_search_fault_returns_safe_503_and_recovers(
+    real_tls_settings: SearchTLSConnection,
+) -> None:
+    prefix = json.loads(os.environ["DIANZI_DOCKER_COMMAND_JSON"])
+    container = "dianzi-test-r01_tls_20261015-opensearch-1"
+    label = subprocess.run(
+        [
+            *prefix,
+            "inspect",
+            container,
+            "--format",
+            '{{index .Config.Labels "com.docker.compose.project"}}',
+        ],
+        capture_output=True,
+        text=True,
+        check=True,
+        timeout=10,
+    )
+    assert label.stdout.strip() == "dianzi-test-r01_tls_20261015"
+    subprocess.run([*prefix, "stop", container], capture_output=True, check=True, timeout=30)
+    try:
+        settings = ApplicationSettings(
+            app_env="test",
+            data_mode="live",
+            database_url=None,
+            redis_url=None,
+            opensearch_url=real_tls_settings.url,
+            opensearch_username=real_tls_settings.username,
+            opensearch_password=real_tls_settings.password,
+            opensearch_ca_file=real_tls_settings.ca_file,
+        )
+        with TestClient(create_application(settings=settings)) as client:
+            response = client.get("/v1/health/ready")
+        if real_tls_settings.password.get_secret_value() in response.text:
+            pytest.fail("secret present in health response")
+        assert response.status_code == 503
+        assert response.json()["dependencies"]["search"] == {
+            "state": "unavailable",
+            "reason": "search connection unavailable",
+        }
+    finally:
+        subprocess.run([*prefix, "start", container], capture_output=True, check=True, timeout=15)
+        deadline = time.monotonic() + 120
+        while True:
+            observed = subprocess.run(
+                [*prefix, "inspect", container, "--format", "{{.State.Health.Status}}"],
+                capture_output=True,
+                text=True,
+                check=True,
+                timeout=10,
+            )
+            if observed.stdout.strip() == "healthy":
+                break
+            assert time.monotonic() < deadline, "secure test search did not recover"
+            time.sleep(1)
