diff --git a/infra/compose/opensearch/opensearch.yml b/infra/compose/opensearch/opensearch.yml
new file mode 100644
index 0000000..811ceff
--- /dev/null
+++ b/infra/compose/opensearch/opensearch.yml
@@ -0,0 +1,20 @@
+cluster.name: dianzi-ai-intel
+node.name: opensearch
+network.host: 0.0.0.0
+discovery.type: single-node
+node.store.allow_mmap: false
+plugins.security.ssl.transport.pemcert_filepath: tls/node.pem
+plugins.security.ssl.transport.pemkey_filepath: tls/node-key.pem
+plugins.security.ssl.transport.pemtrustedcas_filepath: tls/root-ca.pem
+plugins.security.ssl.transport.enforce_hostname_verification: true
+plugins.security.ssl.http.enabled: true
+plugins.security.ssl.http.clientauth_mode: OPTIONAL
+plugins.security.ssl.http.pemcert_filepath: tls/node.pem
+plugins.security.ssl.http.pemkey_filepath: tls/node-key.pem
+plugins.security.ssl.http.pemtrustedcas_filepath: tls/root-ca.pem
+plugins.security.allow_unsafe_democertificates: false
+plugins.security.allow_default_init_securityindex: false
+plugins.security.nodes_dn:
+  - CN=opensearch,OU=AIIntel,O=Dianzi
+plugins.security.authcz.admin_dn:
+  - CN=security-admin,OU=AIIntel,O=Dianzi
diff --git a/infra/compose/secure-search.host.override.yaml b/infra/compose/secure-search.host.override.yaml
new file mode 100644
index 0000000..49620b9
--- /dev/null
+++ b/infra/compose/secure-search.host.override.yaml
@@ -0,0 +1,12 @@
+services:
+  opensearch:
+    network_mode: host
+    networks: !reset []
+    ports: !reset []
+    environment:
+      network.host: 127.0.0.1
+      network.publish_host: 127.0.0.1
+      http.port: ${SECURE_OPENSEARCH_PORT:?Set an exclusive HTTPS port}
+      transport.port: ${SECURE_OPENSEARCH_TRANSPORT_PORT:?Set an exclusive transport port}
+    healthcheck:
+      test: [CMD-SHELL, 'curl -fsS --cacert /usr/share/opensearch/config/tls/root-ca.pem -u "$${OPENSEARCH_USERNAME}:$${OPENSEARCH_INITIAL_ADMIN_PASSWORD}" https://localhost:${SECURE_OPENSEARCH_PORT:?Set an exclusive HTTPS port}/_cluster/health >/dev/null']
