# T08 来源注册模板（必填: 类别/权限授予/解析器版本/能力状态）
# 别名仅用于解析归一, 覆盖统计按实际类别与 source_id 归并。
sources:
  - source_id: "00000000-0000-5000-8000-000000000001"
    display_name: "示例-结构化漏洞源(合成)"
    category: "structured_vulnerability"
    base_origin: "https://example.invalid"
    permission_grant: "granted:public"
    parser_version: "1.0.0"
    capability_status: "configured_not_live"
    aliases: []
